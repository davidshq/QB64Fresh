/* Global Variables */
int32_t a = 0;
int32_t b = 0;

int main(int argc, char** argv) {
    (void)argc; (void)argv;

    int32_t a = 0;
    int32_t b = 0;
    a = 10LL;
    b = 3LL;
    qb_print_int((a + b));
    qb_print_newline();
    qb_print_int((a - b));
    qb_print_newline();
    qb_print_int((a * b));
    qb_print_newline();
    qb_print_float((a / b));
    qb_print_newline();
    qb_print_int((a / b));
    qb_print_newline();
    qb_print_int((a % b));
    qb_print_newline();
    qb_print_float(pow(2LL, 8LL));
    qb_print_newline();
    exit(0);

    return 0;
}
