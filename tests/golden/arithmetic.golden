/* QB64Fresh Runtime Library */

typedef struct qb_string {
    char* data;
    size_t len;
    size_t capacity;
    int refcount;
} qb_string;

qb_string* qb_string_new(const char* s) {
    qb_string* str = malloc(sizeof(qb_string));
    str->len = strlen(s);
    str->capacity = str->len + 1;
    str->data = malloc(str->capacity);
    memcpy(str->data, s, str->len + 1);
    return str;
}

void qb_string_free(qb_string* s) {
    if (s) { free(s->data); free(s); }
}

qb_string* qb_string_concat(qb_string* a, qb_string* b) {
    if (!a) return b ? qb_string_new(b->data) : qb_string_new("");
    if (!b) return qb_string_new(a->data);
    qb_string* result = malloc(sizeof(qb_string));
    result->len = a->len + b->len;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, a->data, a->len);
    memcpy(result->data + a->len, b->data, b->len + 1);
    return result;
}

void qb_print_int(int64_t n) {
    printf("%lld", (long long)n);
}

void qb_print_float(double n) {
    printf("%g", n);
}

void qb_print_string(qb_string* s) {
    if (s && s->data) printf("%s", s->data);
}

void qb_print_newline(void) {
    printf("\n");
}

void qb_print_tab(void) {
    printf("\t");
}

static int qb_cursor_col = 1;
static int qb_cursor_row = 1;

qb_string* qb_tab(int64_t n) {
    if (n < 1) n = 1;
    int spaces_needed = (int)(n - qb_cursor_col);
    if (spaces_needed < 0) spaces_needed = 0;
    char* buf = (char*)malloc(spaces_needed + 1);
    memset(buf, ' ', spaces_needed);
    buf[spaces_needed] = '\0';
    qb_cursor_col = (int)n;
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

qb_string* qb_spc(int64_t n) {
    if (n < 0) n = 0;
    char* buf = (char*)malloc((size_t)n + 1);
    memset(buf, ' ', (size_t)n);
    buf[n] = '\0';
    qb_cursor_col += (int)n;
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

int qb_pos(int64_t n) {
    (void)n; // unused, for compatibility
    return qb_cursor_col;
}

int qb_csrlin(void) {
    return qb_cursor_row;
}

#define QB_TYPE_STRING 0
#define QB_TYPE_INT 1
#define QB_TYPE_DOUBLE 2

typedef struct {
    int type;
    union {
        qb_string* str_val;
        int64_t int_val;
        double dbl_val;
    };
} QbPrintValue;

void qb_print_using(qb_string* fmt, QbPrintValue* values, int num_values) {
    if (!fmt || !fmt->data) return;
    const char* f = fmt->data;
    int val_idx = 0;
    while (*f) {
        // Check for format specifiers
        if (*f == '#' || *f == '+' || *f == '-' || *f == '$' || *f == '*' || *f == '^') {
            // Numeric format - count consecutive format chars
            int width = 0, decimals = 0, has_decimal = 0, has_sign = 0;
            int has_dollar = 0, has_asterisk = 0, has_exp = 0, exp_digits = 0;
            const char* start = f;
            if (*f == '+' || *f == '-') { has_sign = 1; f++; width++; }
            if (*f == '$' && *(f+1) == '$') { has_dollar = 1; f += 2; width += 2; }
            else if (*f == '*' && *(f+1) == '*') { has_asterisk = 1; f += 2; width += 2; }
            while (*f == '#') { width++; f++; }
            if (*f == '.') { has_decimal = 1; f++; width++; while (*f == '#') { decimals++; width++; f++; } }
            while (*f == '^') { has_exp = 1; exp_digits++; f++; width++; }
            // Now format the value
            if (val_idx < num_values && width > 0) {
                double val = 0;
                if (values[val_idx].type == QB_TYPE_INT) val = (double)values[val_idx].int_val;
                else if (values[val_idx].type == QB_TYPE_DOUBLE) val = values[val_idx].dbl_val;
                char buf[64];
                if (has_exp) {
                    snprintf(buf, sizeof(buf), "%*.*e", width, decimals, val);
                } else if (has_decimal) {
                    snprintf(buf, sizeof(buf), "%*.*f", width, decimals, val);
                } else {
                    snprintf(buf, sizeof(buf), "%*lld", width, (long long)val);
                }
                // Handle asterisk fill
                if (has_asterisk) {
                    for (int i = 0; buf[i] == ' '; i++) buf[i] = '*';
                }
                printf("%s", buf);
                val_idx++;
            }
        } else if (*f == '&') {
            // String - print full string
            f++;
            if (val_idx < num_values && values[val_idx].type == QB_TYPE_STRING) {
                if (values[val_idx].str_val && values[val_idx].str_val->data) {
                    printf("%s", values[val_idx].str_val->data);
                }
                val_idx++;
            }
        } else if (*f == '!') {
            // String - print first character only
            f++;
            if (val_idx < num_values && values[val_idx].type == QB_TYPE_STRING) {
                if (values[val_idx].str_val && values[val_idx].str_val->data && values[val_idx].str_val->data[0]) {
                    printf("%c", values[val_idx].str_val->data[0]);
                }
                val_idx++;
            }
        } else if (*f == '\\') {
            // Fixed-width string - count spaces between backslashes
            f++;
            int str_width = 2; // includes both backslashes
            while (*f && *f != '\\') { str_width++; f++; }
            if (*f == '\\') f++;
            if (val_idx < num_values && values[val_idx].type == QB_TYPE_STRING) {
                const char* s = values[val_idx].str_val ? values[val_idx].str_val->data : "";
                printf("%-*.*s", str_width, str_width, s ? s : "");
                val_idx++;
            }
        } else if (*f == '_') {
            // Literal next character
            f++;
            if (*f) { printf("%c", *f); f++; }
        } else {
            // Literal character
            printf("%c", *f);
            f++;
        }
    }
}

void qb_input_string(const char* prompt, qb_string** var) {
    char buffer[1024];
    if (prompt) printf("%s", prompt);
    if (fgets(buffer, sizeof(buffer), stdin)) {
        size_t len = strlen(buffer);
        if (len > 0 && buffer[len-1] == '\n') buffer[len-1] = '\0';
        if (*var) qb_string_free(*var);
        *var = qb_string_new(buffer);
    }
}

void qb_input_int(const char* prompt, int32_t* var) {
    if (prompt) printf("%s", prompt);
    scanf("%d", var);
}

void qb_input_float(const char* prompt, double* var) {
    if (prompt) printf("%s", prompt);
    scanf("%lf", var);
}

int qb_string_compare(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return strcmp(a->data, b->data);
}

int32_t qb_len(qb_string* s) {
    return s ? (int32_t)s->len : 0;
}

qb_string* qb_chr(int32_t code) {
    char buf[2] = { (char)code, '\0' };
    return qb_string_new(buf);
}

int32_t qb_asc(qb_string* s) {
    return (s && s->len > 0) ? (unsigned char)s->data[0] : 0;
}

int32_t qb_sgn(double n) {
    return (n > 0) - (n < 0);
}

double qb_pi(void) {
    return 3.14159265358979323846;
}

double qb_clamp(double value, double min, double max) {
    return value < min ? min : (value > max ? max : value);
}

static uint64_t qb_rng_state = 0x853c49e6748fea9b;

void qb_randomize(double seed) {
    union { double d; uint64_t u; } conv;
    conv.d = seed;
    qb_rng_state = conv.u;
    if (qb_rng_state == 0) qb_rng_state = 1;
}

void qb_randomize_timer(void) {
#ifdef _WIN32
    LARGE_INTEGER pc;
    QueryPerformanceCounter(&pc);
    qb_rng_state = (uint64_t)pc.QuadPart;
#else
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    qb_rng_state = (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
#endif
    if (qb_rng_state == 0) qb_rng_state = 1;
}

float qb_rnd(float n) {
    if (n < 0.0f) {
        /* Negative seed: reseed and return first value */
        qb_randomize((double)n);
    }
    if (n != 0.0f) {
        /* xorshift64 algorithm */
        qb_rng_state ^= qb_rng_state << 13;
        qb_rng_state ^= qb_rng_state >> 7;
        qb_rng_state ^= qb_rng_state << 17;
    }
    return (float)((double)qb_rng_state / (double)UINT64_MAX);
}

int64_t qb_shl(int64_t value, int64_t bits) {
    return (int64_t)((uint64_t)value << (bits & 63));
}

int64_t qb_shr(int64_t value, int64_t bits) {
    return value >> (bits & 63);
}

int64_t qb_rol(int64_t value, int64_t bits) {
    uint64_t v = (uint64_t)value;
    int n = (int)(bits & 63);
    return (int64_t)((v << n) | (v >> (64 - n)));
}

int64_t qb_ror(int64_t value, int64_t bits) {
    uint64_t v = (uint64_t)value;
    int n = (int)(bits & 63);
    return (int64_t)((v >> n) | (v << (64 - n)));
}

int64_t qb_readbit(int64_t value, int64_t bit) {
    return (value >> (bit & 63)) & 1;
}

int64_t qb_setbit(int64_t value, int64_t bit) {
    return value | ((int64_t)1 << (bit & 63));
}

int64_t qb_resetbit(int64_t value, int64_t bit) {
    return value & ~((int64_t)1 << (bit & 63));
}

int64_t qb_togglebit(int64_t value, int64_t bit) {
    return value ^ ((int64_t)1 << (bit & 63));
}

double qb_sec(double n) { return 1.0 / cos(n); }
double qb_csc(double n) { return 1.0 / sin(n); }
double qb_cot(double n) { return 1.0 / tan(n); }

double qb_sech(double n) { return 1.0 / cosh(n); }
double qb_csch(double n) { return 1.0 / sinh(n); }
double qb_coth(double n) { return 1.0 / tanh(n); }

double qb_arcsec(double n) { return acos(1.0 / n); }
double qb_arccsc(double n) { return asin(1.0 / n); }
double qb_arccot(double n) { return atan(1.0 / n); }

double qb_arcsech(double n) { return acosh(1.0 / n); }
double qb_arccsch(double n) { return asinh(1.0 / n); }
double qb_arccoth(double n) { return atanh(1.0 / n); }

double qb_d2r(double degrees) {
    return degrees * 3.14159265358979323846 / 180.0;
}

double qb_r2d(double radians) {
    return radians * 180.0 / 3.14159265358979323846;
}

double qb_d2g(double degrees) {
    return degrees * 10.0 / 9.0;
}

double qb_g2d(double gradians) {
    return gradians * 9.0 / 10.0;
}

double qb_g2r(double gradians) {
    return gradians * 3.14159265358979323846 / 200.0;
}

double qb_r2g(double radians) {
    return radians * 200.0 / 3.14159265358979323846;
}

double qb_negate(double n) {
    return -n;
}

int64_t qb_strcmp(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return strcmp(a->data, b->data);
}

#ifdef _WIN32
int64_t qb_stricmp(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return _stricmp(a->data, b->data);
}
#else
#include <strings.h>
int64_t qb_stricmp(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return strcasecmp(a->data, b->data);
}
#endif

qb_string* qb_left(qb_string* s, int32_t n) {
    if (!s || n <= 0) return qb_string_new("");
    size_t len = (size_t)n < s->len ? (size_t)n : s->len;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data, len);
    result->data[len] = '\0';
    return result;
}

qb_string* qb_right(qb_string* s, int32_t n) {
    if (!s || n <= 0) return qb_string_new("");
    size_t len = (size_t)n < s->len ? (size_t)n : s->len;
    size_t start = s->len - len;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data + start, len);
    result->data[len] = '\0';
    return result;
}

qb_string* qb_mid(qb_string* s, int32_t start, int32_t n) {
    if (!s || start < 1 || n <= 0 || (size_t)start > s->len) return qb_string_new("");
    size_t idx = (size_t)(start - 1);
    size_t len = (idx + (size_t)n > s->len) ? s->len - idx : (size_t)n;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data + idx, len);
    result->data[len] = '\0';
    return result;
}

int32_t qb_instr(int32_t start, qb_string* s, qb_string* find) {
    if (!s || !find || start < 1 || (size_t)start > s->len || find->len == 0) return 0;
    char* pos = strstr(s->data + start - 1, find->data);
    return pos ? (int32_t)(pos - s->data + 1) : 0;
}

qb_string* qb_str(double n) {
    char buf[64];
    snprintf(buf, sizeof(buf), " %g", n);
    return qb_string_new(buf);
}

double qb_val(qb_string* s) {
    return (s && s->data) ? atof(s->data) : 0.0;
}

qb_string* qb_ucase(qb_string* s) {
    if (!s) return qb_string_new("");
    qb_string* result = malloc(sizeof(qb_string));
    result->len = s->len;
    result->capacity = s->len + 1;
    result->data = malloc(result->capacity);
    for (size_t i = 0; i < s->len; i++) result->data[i] = toupper(s->data[i]);
    result->data[s->len] = '\0';
    return result;
}

qb_string* qb_lcase(qb_string* s) {
    if (!s) return qb_string_new("");
    qb_string* result = malloc(sizeof(qb_string));
    result->len = s->len;
    result->capacity = s->len + 1;
    result->data = malloc(result->capacity);
    for (size_t i = 0; i < s->len; i++) result->data[i] = tolower(s->data[i]);
    result->data[s->len] = '\0';
    return result;
}

qb_string* qb_ltrim(qb_string* s) {
    if (!s) return qb_string_new("");
    size_t start = 0;
    while (start < s->len && s->data[start] == ' ') start++;
    return qb_right(s, (int32_t)(s->len - start));
}

qb_string* qb_rtrim(qb_string* s) {
    if (!s) return qb_string_new("");
    size_t end = s->len;
    while (end > 0 && s->data[end - 1] == ' ') end--;
    return qb_left(s, (int32_t)end);
}

qb_string* qb_space(int32_t n) {
    if (n <= 0) return qb_string_new("");
    qb_string* result = malloc(sizeof(qb_string));
    result->len = (size_t)n;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memset(result->data, ' ', result->len);
    result->data[result->len] = '\0';
    return result;
}

qb_string* qb_string_fill(int32_t n, qb_string* c) {
    if (n <= 0 || !c || c->len == 0) return qb_string_new("");
    qb_string* result = malloc(sizeof(qb_string));
    result->len = (size_t)n;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memset(result->data, c->data[0], result->len);
    result->data[result->len] = '\0';
    return result;
}

qb_string* qb_str_from_c(const char* s) {
    return qb_string_new(s);
}

qb_string* qb_str_float(double n) {
    char buf[64];
    snprintf(buf, sizeof(buf), "%g", n);
    return qb_string_new(buf);
}

qb_string* qb_hex(int64_t n) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%llX", (unsigned long long)(uint64_t)n);
    return qb_string_new(buf);
}

qb_string* qb_oct(int64_t n) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%llo", (unsigned long long)(uint64_t)n);
    return qb_string_new(buf);
}

qb_string* qb_bin(int64_t n) {
    char buf[65];
    uint64_t v = (uint64_t)n;
    char* p = buf + 64;
    *p = '\0';
    if (v == 0) { *--p = '0'; }
    else { while (v) { *--p = '0' + (v & 1); v >>= 1; } }
    return qb_string_new(p);
}

qb_string* qb_tostr(double n) {
    char buf[64];
    if (floor(n) == n && n >= -9007199254740992.0 && n <= 9007199254740992.0) {
        snprintf(buf, sizeof(buf), "%.0f", n);
    } else {
        snprintf(buf, sizeof(buf), "%.14g", n);
    }
    return qb_string_new(buf);
}

double qb_iif(int64_t cond, double true_val, double false_val) {
    return cond ? true_val : false_val;
}

qb_string* qb_iif_str(int64_t cond, qb_string* true_val, qb_string* false_val) {
    return cond ? true_val : false_val;
}

/* File I/O Functions */

#define QB_MAX_FILES 512
static FILE* _qb_files[QB_MAX_FILES];
static int32_t _qb_file_reclen[QB_MAX_FILES];

void qb_file_open(int32_t fnum, const char* filename, const char* mode) {
    if (fnum < 1 || fnum >= QB_MAX_FILES) return;
    if (_qb_files[fnum]) fclose(_qb_files[fnum]);
    _qb_files[fnum] = fopen(filename, mode);
    _qb_file_reclen[fnum] = 128; /* default record length */
}

void qb_file_set_reclen(int32_t fnum, int32_t len) {
    if (fnum >= 1 && fnum < QB_MAX_FILES) _qb_file_reclen[fnum] = len;
}

void qb_file_close(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum]) {
        fclose(_qb_files[fnum]);
        _qb_files[fnum] = NULL;
    }
}

void qb_file_close_all(void) {
    for (int i = 1; i < QB_MAX_FILES; i++) {
        if (_qb_files[i]) { fclose(_qb_files[i]); _qb_files[i] = NULL; }
    }
}

void qb_file_print_int(int32_t fnum, int64_t val) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "%lld", (long long)val);
}

void qb_file_print_float(int32_t fnum, double val) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "%g", val);
}

void qb_file_print_string(int32_t fnum, qb_string* s) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum] && s)
        fprintf(_qb_files[fnum], "%s", s->data);
}

void qb_file_print_newline(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "\n");
}

void qb_file_print_tab(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "\t");
}

void qb_file_write_string(int32_t fnum, qb_string* s) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum] && s)
        fprintf(_qb_files[fnum], "\"%s\"", s->data);
}

void qb_file_write_number(int32_t fnum, double val) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "%g", val);
}

void qb_file_write_char(int32_t fnum, char c) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fputc(c, _qb_files[fnum]);
}

void qb_file_input_string(int32_t fnum, qb_string** s) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    char buf[4096];
    int ch, i = 0;
    while ((ch = fgetc(_qb_files[fnum])) != EOF && ch != ',' && ch != '\n' && i < 4095) {
        if (ch == '"') { /* skip quotes */
            while ((ch = fgetc(_qb_files[fnum])) != EOF && ch != '"' && i < 4095)
                buf[i++] = (char)ch;
        } else buf[i++] = (char)ch;
    }
    buf[i] = '\0';
    *s = qb_string_new(buf);
}

void qb_file_input_int(int32_t fnum, int32_t* val) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    fscanf(_qb_files[fnum], "%d", val);
    int ch; while ((ch = fgetc(_qb_files[fnum])) == ',' || ch == ' ');
    if (ch != EOF && ch != '\n') ungetc(ch, _qb_files[fnum]);
}

void qb_file_input_float(int32_t fnum, double* val) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    fscanf(_qb_files[fnum], "%lf", val);
    int ch; while ((ch = fgetc(_qb_files[fnum])) == ',' || ch == ' ');
    if (ch != EOF && ch != '\n') ungetc(ch, _qb_files[fnum]);
}

void qb_file_line_input(int32_t fnum, qb_string** s) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    char buf[4096];
    if (fgets(buf, sizeof(buf), _qb_files[fnum])) {
        size_t len = strlen(buf);
        if (len > 0 && buf[len-1] == '\n') buf[--len] = '\0';
        *s = qb_string_new(buf);
    } else *s = qb_string_new("");
}

void qb_file_seek(int32_t fnum, int64_t pos) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fseek(_qb_files[fnum], (long)(pos - 1), SEEK_SET);
}

void qb_file_seek_record(int32_t fnum, int64_t rec) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fseek(_qb_files[fnum], (long)((rec - 1) * _qb_file_reclen[fnum]), SEEK_SET);
}

void qb_file_get(int32_t fnum, void* data, size_t size) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fread(data, 1, size, _qb_files[fnum]);
}

void qb_file_put(int32_t fnum, const void* data, size_t size) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fwrite(data, 1, size, _qb_files[fnum]);
}

int32_t qb_eof(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        return feof(_qb_files[fnum]) ? -1 : 0;
    return -1;
}

int64_t qb_lof(int32_t fnum) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return 0;
    long pos = ftell(_qb_files[fnum]);
    fseek(_qb_files[fnum], 0, SEEK_END);
    long len = ftell(_qb_files[fnum]);
    fseek(_qb_files[fnum], pos, SEEK_SET);
    return (int64_t)len;
}

int64_t qb_loc(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        return (int64_t)ftell(_qb_files[fnum]) + 1;
    return 0;
}

int32_t qb_freefile(void) {
    for (int i = 1; i < QB_MAX_FILES; i++)
        if (!_qb_files[i]) return i;
    return 0;
}

/* Error Handling */

static int32_t _qb_err = 0;           /* Current error code */
static int32_t _qb_erl = 0;           /* Error line number */
static void* _qb_error_handler = NULL; /* Error handler label */
static int _qb_error_resume_next = 0;  /* ON ERROR RESUME NEXT flag */
static void* _qb_error_line = NULL;    /* Line that caused error */

void qb_error(int32_t code) {
    _qb_err = code;
    if (_qb_error_handler) {
        /* Jump to error handler - handled by generated code */
    }
}

int32_t qb_err_code(void) { return _qb_err; }

int32_t qb_err_line(void) { return _qb_erl; }

int64_t qb_errorline(void) { return _qb_erl; }

static const char* _qb_error_messages[] = {
    "No error",
    "NEXT without FOR",
    "Syntax error",
    "RETURN without GOSUB",
    "Out of DATA",
    "Illegal function call",
    "Overflow",
    "Out of memory",
    "Label not defined",
    "Subscript out of range",
    "Duplicate definition",
    "Division by zero",
    "Type mismatch",
    "Out of string space",
    "String too long",
    "String formula too complex",
};
#define QB_NUM_ERROR_MESSAGES (sizeof(_qb_error_messages)/sizeof(_qb_error_messages[0]))

qb_string* qb_errormessage(void) {
    if (_qb_err >= 0 && (size_t)_qb_err < QB_NUM_ERROR_MESSAGES)
        return qb_string_new(_qb_error_messages[_qb_err]);
    char buf[64];
    snprintf(buf, sizeof(buf), "Error %d", _qb_err);
    return qb_string_new(buf);
}

/* Keyboard Input Functions */

#ifdef _WIN32
#include <conio.h>
qb_string* qb_inkey(void) {
    if (_kbhit()) {
        int ch = _getch();
        if (ch == 0 || ch == 224) {
            char buf[3] = {0, (char)_getch(), 0};
            return qb_string_new(buf);
        }
        char buf[2] = {(char)ch, 0};
        return qb_string_new(buf);
    }
    return qb_string_new("");
}
#else
#include <termios.h>
#include <unistd.h>
#include <sys/select.h>
qb_string* qb_inkey(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    fd_set fds; struct timeval tv = {0, 0};
    FD_ZERO(&fds); FD_SET(STDIN_FILENO, &fds);
    qb_string* result = qb_string_new("");
    if (select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv) > 0) {
        char buf[4] = {0};
        int n = read(STDIN_FILENO, buf, sizeof(buf)-1);
        if (n > 0) result = qb_string_new(buf);
    }
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    return result;
}
#endif

qb_string* qb_input_chars(int32_t n) {
    if (n <= 0) return qb_string_new("");
    char* buf = malloc((size_t)n + 1);
    for (int32_t i = 0; i < n; i++) buf[i] = (char)getchar();
    buf[n] = '\0';
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

qb_string* qb_input_chars_file(int32_t n, int32_t fnum) {
    if (n <= 0 || fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum])
        return qb_string_new("");
    char* buf = malloc((size_t)n + 1);
    size_t read = fread(buf, 1, (size_t)n, _qb_files[fnum]);
    buf[read] = '\0';
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

/* QB64 Keyboard Extensions */

static int64_t _qb_keybuf[256];
static int _qb_keybuf_head = 0;
static int _qb_keybuf_tail = 0;

#ifdef _WIN32
int64_t qb_keyhit(void) {
    if (!_kbhit()) return 0;
    int ch = _getch();
    if (ch == 0 || ch == 224) {
        int ext = _getch();
        return -(ext + 256); // Extended keys as negative
    }
    return ch;
}
#else
int64_t qb_keyhit(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    newt.c_cc[VMIN] = 0;
    newt.c_cc[VTIME] = 0;
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    int ch = getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    if (ch == EOF) return 0;
    if (ch == 27) { // Escape sequence
        tcsetattr(STDIN_FILENO, TCSANOW, &newt);
        int next = getchar();
        tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
        if (next != EOF) return -(next + 256);
    }
    return ch;
}
#endif

int64_t qb_keydown(int64_t code) {
    // Simplified implementation - always returns 0
    // Full implementation requires platform-specific key state checking
    (void)code;
    return 0;
}

#ifdef _WIN32
void qb_keyclear(void) {
    while (_kbhit()) _getch();
}
#else
void qb_keyclear(void) {
    tcflush(STDIN_FILENO, TCIFLUSH);
}
#endif

#ifdef _WIN32
int64_t qb_cinp(void) {
    return _getch();
}
#else
int64_t qb_cinp(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    int ch = getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    return (ch == EOF) ? 0 : ch;
}
#endif

#ifdef _WIN32
int64_t qb_capslock(void) {
    return (GetKeyState(VK_CAPITAL) & 1) ? -1 : 0;
}
int64_t qb_numlock(void) {
    return (GetKeyState(VK_NUMLOCK) & 1) ? -1 : 0;
}
int64_t qb_scrolllock(void) {
    return (GetKeyState(VK_SCROLL) & 1) ? -1 : 0;
}
#else
// On Linux/macOS, lock key states require X11 or reading /sys files
// Simplified stub implementation
int64_t qb_capslock(void) { return 0; }
int64_t qb_numlock(void) { return 0; }
int64_t qb_scrolllock(void) { return 0; }
#endif

/* Environment Functions */

qb_string* qb_environ(qb_string* var) {
    if (!var || !var->data) return qb_string_new("");
    const char* val = getenv(var->data);
    return val ? qb_string_new(val) : qb_string_new("");
}

static int _qb_argc = 0;
static char** _qb_argv = NULL;
void qb_init_args(int argc, char** argv) { _qb_argc = argc; _qb_argv = argv; }

qb_string* qb_command(void) {
    if (_qb_argc <= 1 || !_qb_argv) return qb_string_new("");
    size_t len = 0;
    for (int i = 1; i < _qb_argc; i++) len += strlen(_qb_argv[i]) + 1;
    char* buf = malloc(len + 1);
    buf[0] = '\0';
    for (int i = 1; i < _qb_argc; i++) {
        if (i > 1) strcat(buf, " ");
        strcat(buf, _qb_argv[i]);
    }
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

#ifdef _WIN32
#include <direct.h>
#define getcwd _getcwd
#endif
qb_string* qb_cwd(void) {
    char buf[4096];
    if (getcwd(buf, sizeof(buf))) return qb_string_new(buf);
    return qb_string_new("");
}

qb_string* qb_os(void) {
#ifdef _WIN32
    return qb_string_new("WINDOWS");
#elif defined(__APPLE__)
    return qb_string_new("MACOSX");
#else
    return qb_string_new("LINUX");
#endif
}

static char _qb_startdir[4096] = {};
void qb_init_startdir(void) { getcwd(_qb_startdir, sizeof(_qb_startdir)); }
qb_string* qb_startdir(void) { return qb_string_new(_qb_startdir); }

int32_t qb_instrrev(qb_string* source, qb_string* search) {
    if (!source || !search || search->len == 0) return 0;
    if (search->len > source->len) return 0;
    for (int32_t i = source->len - search->len; i >= 0; i--) {
        if (memcmp(source->data + i, search->data, search->len) == 0) {
            return i + 1; // 1-based
        }
    }
    return 0;
}

qb_string* qb_trim(qb_string* s) {
    if (!s || s->len == 0) return qb_string_new("");
    int32_t start = 0, end = s->len - 1;
    while (start <= end && (s->data[start] == ' ' || s->data[start] == '\t')) start++;
    while (end >= start && (s->data[end] == ' ' || s->data[end] == '\t')) end--;
    if (start > end) return qb_string_new("");
    int32_t newlen = end - start + 1;
    qb_string* result = (qb_string*)malloc(sizeof(qb_string) + newlen + 1);
    result->len = newlen;
    result->refcount = 1;
    memcpy(result->data, s->data + start, newlen);
    result->data[newlen] = '\0';
    return result;
}

qb_string* qb_mki(int16_t n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string) + 3);
    result->len = 2;
    result->refcount = 1;
    memcpy(result->data, &n, 2);
    result->data[2] = '\0';
    return result;
}

qb_string* qb_mkl(int32_t n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string) + 5);
    result->len = 4;
    result->refcount = 1;
    memcpy(result->data, &n, 4);
    result->data[4] = '\0';
    return result;
}

qb_string* qb_mks(float n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string) + 5);
    result->len = 4;
    result->refcount = 1;
    memcpy(result->data, &n, 4);
    result->data[4] = '\0';
    return result;
}

qb_string* qb_mkd(double n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string) + 9);
    result->len = 8;
    result->refcount = 1;
    memcpy(result->data, &n, 8);
    result->data[8] = '\0';
    return result;
}

int16_t qb_cvi(qb_string* s) {
    if (!s || s->len < 2) return 0;
    int16_t result;
    memcpy(&result, s->data, 2);
    return result;
}

int32_t qb_cvl(qb_string* s) {
    if (!s || s->len < 4) return 0;
    int32_t result;
    memcpy(&result, s->data, 4);
    return result;
}

float qb_cvs(qb_string* s) {
    if (!s || s->len < 4) return 0.0f;
    float result;
    memcpy(&result, s->data, 4);
    return result;
}

double qb_cvd(qb_string* s) {
    if (!s || s->len < 8) return 0.0;
    double result;
    memcpy(&result, s->data, 8);
    return result;
}

#ifdef _WIN32
float qb_timer(void) {
    SYSTEMTIME st;
    GetLocalTime(&st);
    return st.wHour * 3600.0f + st.wMinute * 60.0f + st.wSecond + st.wMilliseconds / 1000.0f;
}
#else
float qb_timer(void) {
    struct timeval tv;
    gettimeofday(&tv, NULL);
    struct tm* tm = localtime(&tv.tv_sec);
    return tm->tm_hour * 3600.0f + tm->tm_min * 60.0f + tm->tm_sec + tv.tv_usec / 1000000.0f;
}
#endif

qb_string* qb_date(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%m-%d-%Y", tm);
    return qb_string_new(buf);
}

qb_string* qb_time(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%H:%M:%S", tm);
    return qb_string_new(buf);
}

qb_string* qb_date64(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%Y-%m-%d", tm);
    return qb_string_new(buf);
}

qb_string* qb_time64(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%H:%M:%S", tm);
    return qb_string_new(buf);
}

/* QB64 Memory Operations */

static int32_t qb_current_segment = -1;

void qb_def_seg(int32_t segment) {
    qb_current_segment = segment;
}

int32_t qb_get_segment(void) {
    return qb_current_segment;
}

typedef struct qb_mem {
    void* offset;      /* Pointer to data */
    intptr_t size;     /* Size in bytes */
    intptr_t type;     /* Type info (0=generic) */
    intptr_t elementsize; /* Element size for arrays */
    int32_t image;     /* Image handle if applicable */
    int32_t sound;     /* Sound handle if applicable */
} qb_mem;

qb_mem qb_memnew(intptr_t size) {
    qb_mem m;
    m.offset = (size > 0) ? calloc(1, (size_t)size) : NULL;
    m.size = (m.offset) ? size : 0;
    m.type = 0;
    m.elementsize = 1;
    m.image = 0;
    m.sound = 0;
    return m;
}

void qb_memfree(qb_mem* m) {
    if (m && m->offset) {
        free(m->offset);
        m->offset = NULL;
        m->size = 0;
    }
}

int64_t qb_memget(qb_mem m, intptr_t byteoffset) {
    if (!m.offset || byteoffset < 0 || byteoffset >= m.size) return 0;
    int64_t result = 0;
    size_t copysize = (size_t)(m.size - byteoffset);
    if (copysize > sizeof(int64_t)) copysize = sizeof(int64_t);
    memcpy(&result, (char*)m.offset + byteoffset, copysize);
    return result;
}

void qb_memput(qb_mem m, intptr_t byteoffset, int64_t value) {
    if (!m.offset || byteoffset < 0) return;
    size_t copysize = sizeof(int64_t);
    if (byteoffset + (intptr_t)copysize > m.size) {
        copysize = (size_t)(m.size - byteoffset);
    }
    if (copysize > 0) {
        memcpy((char*)m.offset + byteoffset, &value, copysize);
    }
}

void qb_memcopy(qb_mem src, intptr_t src_offset, intptr_t bytes, qb_mem dest, intptr_t dest_offset) {
    if (!src.offset || !dest.offset) return;
    if (src_offset < 0 || dest_offset < 0 || bytes <= 0) return;
    if (src_offset + bytes > src.size) bytes = src.size - src_offset;
    if (dest_offset + bytes > dest.size) bytes = dest.size - dest_offset;
    if (bytes > 0) {
        memmove((char*)dest.offset + dest_offset, (char*)src.offset + src_offset, (size_t)bytes);
    }
}

void qb_memfill(qb_mem m, intptr_t byteoffset, intptr_t bytes, int32_t value) {
    if (!m.offset || byteoffset < 0 || bytes <= 0) return;
    if (byteoffset + bytes > m.size) bytes = m.size - byteoffset;
    if (bytes > 0) {
        memset((char*)m.offset + byteoffset, (int)(value & 0xFF), (size_t)bytes);
    }
}

intptr_t qb_offset(void* ptr) {
    return (intptr_t)ptr;
}

qb_mem qb_mem_of(void* ptr, intptr_t size) {
    qb_mem m;
    m.offset = ptr;
    m.size = size;
    m.type = 0;
    m.elementsize = 1;
    m.image = 0;
    m.sound = 0;
    return m;
}

/* Timing Functions */

static double qb_last_frame_time = 0.0;

#ifdef _WIN32
static double qb_get_time_seconds(void) {
    LARGE_INTEGER freq, count;
    QueryPerformanceFrequency(&freq);
    QueryPerformanceCounter(&count);
    return (double)count.QuadPart / (double)freq.QuadPart;
}
#else
static double qb_get_time_seconds(void) {
    struct timeval tv;
    gettimeofday(&tv, NULL);
    return (double)tv.tv_sec + (double)tv.tv_usec / 1000000.0;
}
#endif

#ifdef _WIN32
void qb_sleep(int seconds) {
    Sleep(seconds * 1000);
}
#else
void qb_sleep(int seconds) {
    sleep(seconds);
}
#endif

#ifdef _WIN32
void qb_sleep_keypress(void) {
    _getch();
}
#else
void qb_sleep_keypress(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
}
#endif

#ifdef _WIN32
void qb_delay(double seconds) {
    Sleep((DWORD)(seconds * 1000.0));
}
#else
void qb_delay(double seconds) {
    usleep((useconds_t)(seconds * 1000000.0));
}
#endif

void qb_limit(int fps) {
    if (fps <= 0) return;
    double target_frame_time = 1.0 / (double)fps;
    double current_time = qb_get_time_seconds();
    if (qb_last_frame_time > 0.0) {
        double elapsed = current_time - qb_last_frame_time;
        double wait_time = target_frame_time - elapsed;
        if (wait_time > 0.0) {
#ifdef _WIN32
            Sleep((DWORD)(wait_time * 1000.0));
#else
            usleep((useconds_t)(wait_time * 1000000.0));
#endif
        }
    }
    qb_last_frame_time = qb_get_time_seconds();
}

/* Array Functions */

void qb_array_erase(void* arr) {
    // Arrays are allocated on stack, so we just zero them
    // For dynamic arrays, this would free and reallocate
    // Currently a no-op as our arrays are fixed-size
}

/* Audio Functions (Inline Runtime) */
/* For full audio support, use --runtime external and link with libqb64fresh_rt */

static int _qb_audio_warned = 0;
static void _qb_audio_warn(void) {
    if (!_qb_audio_warned) {
        fprintf(stderr, "Warning: Audio functions require external runtime. Use --runtime external\n");
        _qb_audio_warned = 1;
    }
}

void qb_beep(void) {
#ifdef _WIN32
    Beep(800, 250); /* 800Hz for 250ms */
#else
    printf("\a"); fflush(stdout); /* ASCII bell */
#endif
}

void qb_sound(double frequency, double duration) {
#ifdef _WIN32
    if (frequency > 37 && frequency < 32767) {
        /* Duration is in clock ticks (18.2/sec) */
        int ms = (int)(duration * 1000.0 / 18.2);
        Beep((DWORD)frequency, (DWORD)ms);
    }
#else
    _qb_audio_warn();
    (void)frequency; (void)duration;
#endif
}

void qb_play(qb_string* commands) {
    _qb_audio_warn();
    (void)commands;
}

int32_t qb_sndopen(qb_string* filename) {
    _qb_audio_warn();
    (void)filename;
    return -1; /* Return invalid handle */
}

void qb_sndclose(int32_t handle) {
    (void)handle;
}

void qb_sndplay(int32_t handle) {
    _qb_audio_warn();
    (void)handle;
}

void qb_sndstop(int32_t handle) {
    (void)handle;
}

void qb_sndpause(int32_t handle) {
    (void)handle;
}

void qb_sndloop(int32_t handle) {
    _qb_audio_warn();
    (void)handle;
}

void qb_sndvol(int32_t handle, double volume) {
    (void)handle; (void)volume;
}

void qb_sndbal(int32_t handle, double balance) {
    (void)handle; (void)balance;
}

double qb_sndlen(int32_t handle) {
    (void)handle;
    return 0.0;
}

double qb_sndgetpos(int32_t handle) {
    (void)handle;
    return 0.0;
}

void qb_sndsetpos(int32_t handle, double position) {
    (void)handle; (void)position;
}

int32_t qb_sndplaying(int32_t handle) {
    (void)handle;
    return 0;
}

int32_t qb_sndpaused(int32_t handle) {
    (void)handle;
    return 0;
}

