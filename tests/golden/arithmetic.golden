/* File Content Helpers */

qb_string* qb_readfile(qb_string* path) {
    FILE* f = fopen(path->data, "rb");
    if (!f) return qb_string_new("");
    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);
    char* buf = (char*)malloc(size + 1);
    if (!buf) { fclose(f); return qb_string_new(""); }
    fread(buf, 1, size, f);
    buf[size] = '\0';
    fclose(f);
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

void qb_writefile(qb_string* path, qb_string* content) {
    FILE* f = fopen(path->data, "wb");
    if (!f) return;
    fwrite(content->data, 1, content->len, f);
    fclose(f);
}

/* Utility Functions */

int64_t qb_commandcount(void) { return _qb_argc - 1; }

#ifdef _WIN32
int64_t qb_environcount(void) {
    int count = 0;
    char* env = GetEnvironmentStringsA();
    if (env) {
        char* p = env;
        while (*p) { count++; p += strlen(p) + 1; }
        FreeEnvironmentStringsA(env);
    }
    return count;
}
#else
extern char** environ;
int64_t qb_environcount(void) {
    int count = 0;
    if (environ) {
        while (environ[count]) count++;
    }
    return count;
}
#endif

/* Font Stubs */
static int64_t _qb_current_font = 0;
int64_t qb_loadfont(qb_string* file, int64_t size) { _qb_gfx_warn(); (void)file; (void)size; return 0; }
int64_t qb_font(int64_t handle) {
    int64_t prev = _qb_current_font;
    _qb_current_font = handle;
    return prev;
}
int64_t qb_freefont(int64_t handle) { (void)handle; return 0; }
int64_t qb_fontheight(void) { return 16; }
int64_t qb_fontwidth(void) { return 8; }
int64_t qb_printwidth(qb_string* text) {
    if (text == NULL || text->data == NULL) return 0;
    return (int64_t)text->length * qb_fontwidth();
}

