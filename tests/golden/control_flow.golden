/* QB4.5 Memory Functions (stubs) */

int32_t qb_fre(int64_t n) {
    (void)n;
    // Return a large value indicating plenty of memory
    // n=-1: string space, n=-2: stack, n=0: far heap
    return 64 * 1024 * 1024; // 64 MB (arbitrary large value)
}

void qb_free(void) {
    // String garbage collection is automatic
}

/* QB4.5 Port I/O Functions - VGA Palette Emulation */

static int _qb_h3c7_read_index = 0;  // Palette read index (port 0x3C7)
static int _qb_h3c8_write_index = 0; // Palette write index (port 0x3C8)
static int _qb_h3c9_read_next = 0;   // Which RGB component to read next (0=R,1=G,2=B)
static int _qb_h3c9_write_next = 0;  // Which RGB component to write next
static int _qb_vertical_retrace = 0; // Simulated vertical retrace flag

static void _qb_init_palette(void) {
    // Initialize with standard VGA palette (simplified)
    for (int i = 0; i < 256; i++) {
        _qb_palette[i] = 0xFF000000 | (i << 16) | (i << 8) | i; // Grayscale default
    }
    // Standard 16-color VGA palette
    _qb_palette[0] = 0xFF000000;  // Black
    _qb_palette[1] = 0xFF0000AA;  // Blue
    _qb_palette[2] = 0xFF00AA00;  // Green
    _qb_palette[3] = 0xFF00AAAA;  // Cyan
    _qb_palette[4] = 0xFFAA0000;  // Red
    _qb_palette[5] = 0xFFAA00AA;  // Magenta
    _qb_palette[6] = 0xFFAA5500;  // Brown
    _qb_palette[7] = 0xFFAAAAAA;  // Light gray
    _qb_palette[8] = 0xFF555555;  // Dark gray
    _qb_palette[9] = 0xFF5555FF;  // Light blue
    _qb_palette[10] = 0xFF55FF55; // Light green
    _qb_palette[11] = 0xFF55FFFF; // Light cyan
    _qb_palette[12] = 0xFFFF5555; // Light red
    _qb_palette[13] = 0xFFFF55FF; // Light magenta
    _qb_palette[14] = 0xFFFFFF55; // Yellow
    _qb_palette[15] = 0xFFFFFFFF; // White
}

int qb_inp(int64_t port) {
    int p = (int)(port & 0xFFFF);
    int value;

    // Port 0x3C9: Read palette RGB values
    if (p == 0x3C9) {
        uint32_t color = _qb_palette[_qb_h3c7_read_index];
        if (_qb_h3c9_read_next == 0) { // Red
            value = ((color >> 16) & 0xFF) >> 2; // Convert 0-255 to 0-63
        } else if (_qb_h3c9_read_next == 1) { // Green
            value = ((color >> 8) & 0xFF) >> 2;
        } else { // Blue
            value = (color & 0xFF) >> 2;
        }
        _qb_h3c9_read_next++;
        if (_qb_h3c9_read_next >= 3) {
            _qb_h3c9_read_next = 0;
            _qb_h3c7_read_index = (_qb_h3c7_read_index + 1) & 0xFF;
        }
        return value;
    }

    // Port 0x3DA: Input Status Register #1 (vertical retrace)
    if (p == 0x3DA) {
        // Toggle vertical retrace bit to prevent infinite loops
        _qb_vertical_retrace = !_qb_vertical_retrace;
        return _qb_vertical_retrace ? 8 : 0; // Bit 3 = vertical retrace
    }

    // Unsupported port - return 0
    return 0;
}

void qb_out(int32_t port, int32_t value) {
    int p = port & 0xFFFF;
    int v = value & 0xFF;

    // Port 0x3C7: Set palette read index
    if (p == 0x3C7) {
        _qb_h3c7_read_index = v;
        _qb_h3c9_read_next = 0;
        return;
    }

    // Port 0x3C8: Set palette write index
    if (p == 0x3C8) {
        _qb_h3c8_write_index = v;
        _qb_h3c9_write_next = 0;
        return;
    }

    // Port 0x3C9: Write palette RGB values
    if (p == 0x3C9) {
        int rgb = (v & 63) << 2; // Convert 0-63 to 0-252
        if (_qb_h3c9_write_next == 0) { // Red
            _qb_palette[_qb_h3c8_write_index] &= 0xFF00FFFF;
            _qb_palette[_qb_h3c8_write_index] |= (rgb << 16);
        } else if (_qb_h3c9_write_next == 1) { // Green
            _qb_palette[_qb_h3c8_write_index] &= 0xFFFF00FF;
            _qb_palette[_qb_h3c8_write_index] |= (rgb << 8);
        } else { // Blue
            _qb_palette[_qb_h3c8_write_index] &= 0xFFFFFF00;
            _qb_palette[_qb_h3c8_write_index] |= rgb;
        }
        _qb_h3c9_write_next++;
        if (_qb_h3c9_write_next >= 3) {
            _qb_h3c9_write_next = 0;
            _qb_h3c8_write_index = (_qb_h3c8_write_index + 1) & 0xFF;
        }
        return;
    }

    // Port 0x3C0: Attribute controller (blink enable, etc.) - no-op
    // Other ports: silently ignored
}

void qb_wait(int32_t port, int32_t and_mask, int32_t xor_mask) {
    int p = port & 0xFFFF;
    int value;

    // Only emulate WAIT for vertical retrace (port 0x3DA)
    if (p == 0x3DA) {
        // Simulate waiting for vertical retrace
        // Toggle the retrace flag to prevent infinite loops
        _qb_vertical_retrace = 1;
        return;
    }

    // For unsupported ports, return immediately (like QB64pe)
    // This prevents infinite loops in legacy code
}

/* QB4.5 Light Pen Function (stub with warning) */
static int _qb_warned_pen = 0;

int qb_pen(int64_t n) {
    (void)n;
    if (!_qb_warned_pen) {
        _qb_warned_pen = 1;
        fprintf(stderr, "QB64Fresh: PEN() is not supported on modern systems (light pens are obsolete hardware)\n");
        fflush(stderr);
    }
    return 0; // Light pen not present
}

/* QB4.5 Serial I/O Functions (stubs with warnings) */
static int _qb_warned_erdev = 0;
static int _qb_warned_ioctl = 0;

int qb_erdev(void) {
    if (!_qb_warned_erdev) {
        _qb_warned_erdev = 1;
        fprintf(stderr, "QB64Fresh: ERDEV/ERDEV$ are not supported (DOS device error functions)\n");
        fflush(stderr);
    }
    return 0; // No device error
}

qb_string* qb_erdev_str(void) {
    if (!_qb_warned_erdev) {
        _qb_warned_erdev = 1;
        fprintf(stderr, "QB64Fresh: ERDEV/ERDEV$ are not supported (DOS device error functions)\n");
        fflush(stderr);
    }
    return qb_string_new(""); // No device error
}

void qb_ioctl(int32_t file_num, qb_string* control_string) {
    (void)file_num; (void)control_string;
    if (!_qb_warned_ioctl) {
        _qb_warned_ioctl = 1;
        fprintf(stderr, "QB64Fresh: IOCTL/IOCTL$ are not supported (DOS device control functions)\n");
        fflush(stderr);
    }
}

qb_string* qb_ioctl_str(int64_t file_num) {
    (void)file_num;
    if (!_qb_warned_ioctl) {
        _qb_warned_ioctl = 1;
        fprintf(stderr, "QB64Fresh: IOCTL/IOCTL$ are not supported (DOS device control functions)\n");
        fflush(stderr);
    }
    return qb_string_new(""); // Empty status string
}

/* QB4.5 System Interrupt Functions (INT 0x33 mouse emulation) */
static int _qb_warned_interrupt = 0;

static void _qb_call_int(int32_t int_num, int16_t* regs) {
    /* regs: AX, BX, CX, DX, BP, SI, DI, FLAGS */
    if (int_num == 0x33) {
        /* Mouse interrupt emulation */
        int16_t ax = regs[0];
        if (ax == 0) {
            /* Check mouse installed */
            regs[0] = (int16_t)0xFFFF; /* Mouse installed */
            regs[1] = 2; /* 2 buttons */
            return;
        }
        if (ax == 1) {
            /* Show mouse cursor */
            qb_mouse_show();
            return;
        }
        if (ax == 2) {
            /* Hide mouse cursor */
            qb_mouse_hide();
            return;
        }
        if (ax == 3) {
            /* Get mouse position and button status */
            int32_t buttons = 0;
            if (qb_mouse_button(1)) buttons |= 1;
            if (qb_mouse_button(2)) buttons |= 2;
            if (qb_mouse_button(3)) buttons |= 4;
            regs[1] = (int16_t)buttons; /* BX = buttons */
            regs[2] = (int16_t)qb_mouse_x(); /* CX = X */
            regs[3] = (int16_t)qb_mouse_y(); /* DX = Y */
            return;
        }
        if (ax == 4) {
            /* Set mouse position - CX=X, DX=Y */
            /* Note: qb_mouse_move may not exist in all backends */
            /* For now, this is a no-op for compatibility */
            return;
        }
        /* AX=5,6 (button press/release info) - no-op, returns 0 */
        if (ax == 5 || ax == 6) {
            regs[0] = 0; /* No button info */
            regs[1] = 0; /* Press count = 0 */
            regs[2] = 0; regs[3] = 0; /* Position = 0,0 */
            return;
        }
        /* AX=7,8 (min/max range) - no-op for compatibility */
        return;
    }
    /* Unsupported interrupt - warn once */
    if (!_qb_warned_interrupt) {
        _qb_warned_interrupt = 1;
        fprintf(stderr, "QB64Fresh: INTERRUPT/INTERRUPTX only supports INT 0x33 (mouse). Other interrupts (0x%02X) are ignored.\n", int_num);
        fflush(stderr);
    }
}

void qb_interrupt(int32_t int_num, void* in_regs, void* out_regs) {
    int16_t* in_r = (int16_t*)in_regs;
    int16_t* out_r = (int16_t*)out_regs;
    /* Copy input registers to output as working copy */
    for (int i = 0; i < 8; i++) out_r[i] = in_r[i];
    _qb_call_int(int_num, out_r);
}

void qb_interruptx(int32_t int_num, void* in_regs, void* out_regs) {
    int16_t* in_r = (int16_t*)in_regs;
    int16_t* out_r = (int16_t*)out_regs;
    /* Copy input registers to output as working copy */
    for (int i = 0; i < 10; i++) out_r[i] = in_r[i];
    _qb_call_int(int_num, out_r);
}

/* GOSUB Return Stack */
#define GOSUB_STACK_SIZE 256
static void* _gosub_stack[GOSUB_STACK_SIZE];
static int _gosub_sp = 0;

/* Global Variables */
int32_t x = 0;

int main(int argc, char** argv) {
    qb_init_args(argc, argv);
    qb_init_startdir();
    _qb_init_palette();
    static uint32_t _qb_strig_event_id = 0;

    uint64_t _qbs_main_base = qbs_tmp_base_get();

    qbs_cleanup(_qbs_main_base, 0);
    x = 5LL;
    qbs_cleanup(_qbs_main_base, 0);
    if (-(x > 3LL)) {
        qb_print_string(qb_string_new("Greater"));
        qb_print_newline();
    } else if (-(x == 3LL)) {
        qb_print_string(qb_string_new("Equal"));
        qb_print_newline();
    } else {
        qb_print_string(qb_string_new("Less"));
        qb_print_newline();
    }
    qbs_cleanup(_qbs_main_base, 0);
    exit(0);
    qbs_cleanup(_qbs_main_base, 0);

    /* STRIG Event Dispatch */
    goto _qb_strig_dispatch_end;
_qb_strig_dispatch:
    goto *_gosub_stack[--_gosub_sp];
_qb_strig_dispatch_end:

    return 0;
}
