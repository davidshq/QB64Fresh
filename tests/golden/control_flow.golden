}

int32_t qb_asc2(qb_string* s, int32_t pos) {
    if (!s || pos < 1 || pos > (int32_t)s->len) return 0;
    return (unsigned char)s->data[pos - 1];
}

int32_t qb_sgn(double n) {
    return (n > 0) - (n < 0);
}

double qb_pi(void) {
    return 3.14159265358979323846;
}

double qb_clamp(double value, double min, double max) {
    return value < min ? min : (value > max ? max : value);
}

static uint64_t qb_rng_state = 0x853c49e6748fea9b;

void qb_randomize(double seed) {
    union { double d; uint64_t u; } conv;
    conv.d = seed;
    qb_rng_state = conv.u;
    if (qb_rng_state == 0) qb_rng_state = 1;
}

void qb_randomize_timer(void) {
#ifdef _WIN32
    LARGE_INTEGER pc;
    QueryPerformanceCounter(&pc);
    qb_rng_state = (uint64_t)pc.QuadPart;
#else
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    qb_rng_state = (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
#endif
    if (qb_rng_state == 0) qb_rng_state = 1;
}

float qb_rnd(float n) {
    if (n < 0.0f) {
        /* Negative seed: reseed and return first value */
        qb_randomize((double)n);
    }
    if (n != 0.0f) {
        /* xorshift64 algorithm */
        qb_rng_state ^= qb_rng_state << 13;
        qb_rng_state ^= qb_rng_state >> 7;
        qb_rng_state ^= qb_rng_state << 17;
    }
    return (float)((double)qb_rng_state / (double)UINT64_MAX);
}

int64_t qb_shl(int64_t value, int64_t bits) {
    return (int64_t)((uint64_t)value << (bits & 63));
}

int64_t qb_shr(int64_t value, int64_t bits) {
    return value >> (bits & 63);
}

int64_t qb_rol(int64_t value, int64_t bits) {
    uint64_t v = (uint64_t)value;
    int n = (int)(bits & 63);
    return (int64_t)((v << n) | (v >> (64 - n)));
}

int64_t qb_ror(int64_t value, int64_t bits) {
    uint64_t v = (uint64_t)value;
    int n = (int)(bits & 63);
    return (int64_t)((v >> n) | (v << (64 - n)));
}

int64_t qb_readbit(int64_t value, int64_t bit) {
    return (value >> (bit & 63)) & 1;
}

int64_t qb_setbit(int64_t value, int64_t bit) {
    return value | ((int64_t)1 << (bit & 63));
}

int64_t qb_resetbit(int64_t value, int64_t bit) {
    return value & ~((int64_t)1 << (bit & 63));
}

int64_t qb_togglebit(int64_t value, int64_t bit) {
    return value ^ ((int64_t)1 << (bit & 63));
}

double qb_sec(double n) { return 1.0 / cos(n); }
double qb_csc(double n) { return 1.0 / sin(n); }
double qb_cot(double n) { return 1.0 / tan(n); }

double qb_sech(double n) { return 1.0 / cosh(n); }
double qb_csch(double n) { return 1.0 / sinh(n); }
double qb_coth(double n) { return 1.0 / tanh(n); }

double qb_arcsec(double n) { return acos(1.0 / n); }
double qb_arccsc(double n) { return asin(1.0 / n); }
double qb_arccot(double n) { return atan(1.0 / n); }

double qb_arcsech(double n) { return acosh(1.0 / n); }
double qb_arccsch(double n) { return asinh(1.0 / n); }
double qb_arccoth(double n) { return atanh(1.0 / n); }

double qb_d2r(double degrees) {
    return degrees * 3.14159265358979323846 / 180.0;
}

double qb_r2d(double radians) {
    return radians * 180.0 / 3.14159265358979323846;
}

double qb_d2g(double degrees) {
    return degrees * 10.0 / 9.0;
}

double qb_g2d(double gradians) {
    return gradians * 9.0 / 10.0;
}

double qb_g2r(double gradians) {
    return gradians * 3.14159265358979323846 / 200.0;
}

double qb_r2g(double radians) {
    return radians * 200.0 / 3.14159265358979323846;
}

double qb_negate(double n) {
    return -n;
}

int64_t qb_strcmp(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return strcmp(a->data, b->data);
}

#ifdef _WIN32
int64_t qb_stricmp(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return _stricmp(a->data, b->data);
}
#else
#include <strings.h>
int64_t qb_stricmp(qb_string* a, qb_string* b) {
    if (!a && !b) return 0;
    if (!a) return -1;
    if (!b) return 1;
    return strcasecmp(a->data, b->data);
}
#endif

qb_string* qb_left(qb_string* s, int32_t n) {
    if (!s || n <= 0) return &_qbs_empty;
    size_t len = (size_t)n < s->len ? (size_t)n : s->len;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data, len);
    result->data[len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_right(qb_string* s, int32_t n) {
    if (!s || n <= 0) return &_qbs_empty;
    size_t len = (size_t)n < s->len ? (size_t)n : s->len;
    size_t start = s->len - len;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data + start, len);
    result->data[len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_mid(qb_string* s, int32_t start, int32_t n) {
    if (!s || start < 1 || n <= 0 || (size_t)start > s->len) return &_qbs_empty;
    size_t idx = (size_t)(start - 1);
    size_t len = (idx + (size_t)n > s->len) ? s->len - idx : (size_t)n;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data + idx, len);
    result->data[len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_mid2(qb_string* s, int32_t start) {
    if (!s || start < 1 || (size_t)start > s->len) return &_qbs_empty;
    size_t idx = (size_t)(start - 1);
    size_t len = s->len - idx;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = len;
    result->capacity = len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, s->data + idx, len);
    result->data[len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

void qb_mid_assign(qb_string** target, int32_t start, int32_t length, qb_string* value) {
    if (!target || !*target || !value) return;
    qb_string* s = *target;
    if (start < 1 || (size_t)start > s->len) return;
    size_t idx = (size_t)(start - 1);
    size_t max_len = s->len - idx;
    size_t replace_len;
    if (length < 0) {
        replace_len = (value->len < max_len) ? value->len : max_len;
    } else {
        replace_len = ((size_t)length < max_len) ? (size_t)length : max_len;
        if (replace_len > value->len) replace_len = value->len;
    }
    memcpy(s->data + idx, value->data, replace_len);
}

int32_t qb_instr(int32_t start, qb_string* s, qb_string* find) {
    if (!s || !find || start < 1 || (size_t)start > s->len || find->len == 0) return 0;
    char* pos = strstr(s->data + start - 1, find->data);
    return pos ? (int32_t)(pos - s->data + 1) : 0;
}

int32_t qb_instr2(qb_string* s, qb_string* find) {
    return qb_instr(1, s, find);
}

qb_string* qb_str(double n) {
    char buf[64];
    snprintf(buf, sizeof(buf), " %g", n);
    return qb_string_new(buf);
}

double qb_val(qb_string* s) {
    return (s && s->data) ? atof(s->data) : 0.0;
}

qb_string* qb_ucase(qb_string* s) {
    if (!s) return &_qbs_empty;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = s->len;
    result->capacity = s->len + 1;
    result->data = malloc(result->capacity);
    for (size_t i = 0; i < s->len; i++) {
        unsigned char c = (unsigned char)s->data[i];
        // Only convert ASCII lowercase (single-byte chars)
        if (c >= 'a' && c <= 'z') {
            result->data[i] = c - 32;
        } else {
            result->data[i] = s->data[i];
        }
    }
    result->data[s->len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_lcase(qb_string* s) {
    if (!s) return &_qbs_empty;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = s->len;
    result->capacity = s->len + 1;
    result->data = malloc(result->capacity);
    for (size_t i = 0; i < s->len; i++) {
        unsigned char c = (unsigned char)s->data[i];
        // Only convert ASCII uppercase (single-byte chars)
        if (c >= 'A' && c <= 'Z') {
            result->data[i] = c + 32;
        } else {
            result->data[i] = s->data[i];
        }
    }
    result->data[s->len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_ltrim(qb_string* s) {
    if (!s) return &_qbs_empty;
    size_t start = 0;
    while (start < s->len && s->data[start] == ' ') start++;
    return qb_right(s, (int32_t)(s->len - start));
}

qb_string* qb_rtrim(qb_string* s) {
    if (!s) return &_qbs_empty;
    size_t end = s->len;
    while (end > 0 && s->data[end - 1] == ' ') end--;
    return qb_left(s, (int32_t)end);
}

qb_string* qb_space(int32_t n) {
    if (n <= 0) return &_qbs_empty;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = (size_t)n;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memset(result->data, ' ', result->len);
    result->data[result->len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_string_fill(int32_t n, qb_string* c) {
    if (n <= 0 || !c || c->len == 0) return &_qbs_empty;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = (size_t)n;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memset(result->data, c->data[0], result->len);
    result->data[result->len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

qb_string* qb_string_fill_code(int32_t n, int32_t code) {
    if (n <= 0) return &_qbs_empty;
    qb_string* result = malloc(sizeof(qb_string));
    result->len = (size_t)n;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memset(result->data, (unsigned char)code, result->len);
    result->data[result->len] = '\0';
    result->refcount = 1;
    return qbs_tmp_register(result);
}

// UTF-8 helper functions
size_t qb_utf8_char_count(qb_string* s) {
    if (!s) return 0;
    size_t count = 0;
    for (size_t i = 0; i < s->len; ) {
        unsigned char c = (unsigned char)s->data[i];
        if ((c & 0x80) == 0) i += 1;        // ASCII
        else if ((c & 0xE0) == 0xC0) i += 2; // 2-byte
        else if ((c & 0xF0) == 0xE0) i += 3; // 3-byte
        else if ((c & 0xF8) == 0xF0) i += 4; // 4-byte
        else i += 1; // Invalid UTF-8, skip byte
        count++;
    }
    return count;
}

size_t qb_utf8_char_to_byte(qb_string* s, size_t char_pos) {
    if (!s || char_pos < 1) return 0;
    size_t byte_pos = 0;
    size_t char_count = 0;
    while (byte_pos < s->len && char_count < char_pos - 1) {
        unsigned char c = (unsigned char)s->data[byte_pos];
        if ((c & 0x80) == 0) byte_pos += 1;
        else if ((c & 0xE0) == 0xC0) byte_pos += 2;
        else if ((c & 0xF0) == 0xE0) byte_pos += 3;
        else if ((c & 0xF8) == 0xF0) byte_pos += 4;
        else byte_pos += 1;
        char_count++;
    }
    return byte_pos;
}

int32_t qb_strlen_chars(qb_string* s) {
    return (int32_t)qb_utf8_char_count(s);
}

qb_string* qb_str_from_c(const char* s) {
    return qb_string_new(s);
}

qb_string* qb_str_float(double n) {
    char buf[64];
    snprintf(buf, sizeof(buf), "%g", n);
    return qb_string_new(buf);
}

qb_string* qb_hex(int64_t n) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%llX", (unsigned long long)(uint64_t)n);
    return qb_string_new(buf);
}

qb_string* qb_oct(int64_t n) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%llo", (unsigned long long)(uint64_t)n);
    return qb_string_new(buf);
}

qb_string* qb_bin(int64_t n) {
    char buf[65];
    uint64_t v = (uint64_t)n;
    char* p = buf + 64;
    *p = '\0';
    if (v == 0) { *--p = '0'; }
    else { while (v) { *--p = '0' + (v & 1); v >>= 1; } }
    return qb_string_new(p);
}

qb_string* qb_tostr(double n) {
    char buf[64];
    if (floor(n) == n && n >= -9007199254740992.0 && n <= 9007199254740992.0) {
        snprintf(buf, sizeof(buf), "%.0f", n);
    } else {
        snprintf(buf, sizeof(buf), "%.14g", n);
    }
    return qb_string_new(buf);
}

double qb_iif(int64_t cond, double true_val, double false_val) {
    return cond ? true_val : false_val;
}

qb_string* qb_iif_str(int64_t cond, qb_string* true_val, qb_string* false_val) {
    return cond ? true_val : false_val;
}

/* File I/O Functions */

#define QB_MAX_FILES 512
static FILE* _qb_files[QB_MAX_FILES];
static int32_t _qb_file_reclen[QB_MAX_FILES];

/* Network I/O Functions (extern - from Rust runtime) */
extern size_t qb_net_get(int64_t handle, uint8_t* data, size_t size);
extern size_t qb_net_put(int64_t handle, const uint8_t* data, size_t size);
extern size_t qb_net_get_string(int64_t handle, qb_string* s);
extern size_t qb_net_put_string(int64_t handle, const qb_string* s);
extern int32_t qb_net_eof(int64_t handle);
extern int64_t qb_net_lof(int64_t handle);
extern void qb_net_close(int64_t handle);

static void _qb_file_set(int32_t fnum, FILE* f) {
    if (fnum < 1 || fnum >= QB_MAX_FILES) return;
    if (_qb_files[fnum]) fclose(_qb_files[fnum]);
    _qb_files[fnum] = f;
    _qb_file_reclen[fnum] = 128;
}

#ifndef _WIN32
static char* _qb_normalize_path(const char* path) {
    if (!path) return NULL;
    size_t len = strlen(path);
    char* normalized = malloc(len + 1);
    for (size_t i = 0; i <= len; i++) {
        normalized[i] = (path[i] == '\\') ? '/' : path[i];
    }
    return normalized;
}
#endif

void qb_file_open(int32_t fnum, const char* filename, const char* mode) {
    if (fnum < 1 || fnum >= QB_MAX_FILES) return;
    if (_qb_files[fnum]) fclose(_qb_files[fnum]);
#ifdef _WIN32
    _qb_files[fnum] = fopen(filename, mode);
#else
    char* normalized = _qb_normalize_path(filename);
    const char* path_to_use = normalized ? normalized : filename;
    _qb_files[fnum] = fopen(path_to_use, mode);
    if (!_qb_files[fnum] && mode[0] == 'r' && mode[1] == '+') {
        FILE* tmp = fopen(path_to_use, "w"); if (tmp) fclose(tmp);
        _qb_files[fnum] = fopen(path_to_use, mode);
    }
    if (normalized) free(normalized);
#endif
    _qb_file_reclen[fnum] = 128; /* default record length */
}

void qb_file_set_reclen(int32_t fnum, int32_t len) {
    if (fnum >= 1 && fnum < QB_MAX_FILES) _qb_file_reclen[fnum] = len;
}

void qb_file_close(int32_t fnum) {
    if (fnum < 0) {
        qb_net_close((int64_t)fnum);
        return;
    }
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum]) {
        fclose(_qb_files[fnum]);
        _qb_files[fnum] = NULL;
    }
}

void qb_file_close_all(void) {
    for (int i = 1; i < QB_MAX_FILES; i++) {
        if (_qb_files[i]) { fclose(_qb_files[i]); _qb_files[i] = NULL; }
    }
}

void qb_file_print_int(int32_t fnum, int64_t val) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "%lld", (long long)val);
}

void qb_file_print_float(int32_t fnum, double val) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "%g", val);
}

void qb_file_print_string(int32_t fnum, qb_string* s) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum] && s)
        fprintf(_qb_files[fnum], "%s", s->data);
}

void qb_file_print_newline(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "\n");
}

void qb_file_print_tab(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "\t");
}

void qb_file_write_string(int32_t fnum, qb_string* s) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum] && s)
        fprintf(_qb_files[fnum], "\"%s\"", s->data);
}

void qb_file_write_number(int32_t fnum, double val) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fprintf(_qb_files[fnum], "%g", val);
}

void qb_file_write_char(int32_t fnum, char c) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fputc(c, _qb_files[fnum]);
}

void qb_file_input_string(int32_t fnum, qb_string** s) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    char buf[4096];
    int ch, i = 0;
    while ((ch = fgetc(_qb_files[fnum])) != EOF && ch != ',' && ch != '\n' && i < 4095) {
        if (ch == '"') { /* skip quotes */
            while ((ch = fgetc(_qb_files[fnum])) != EOF && ch != '"' && i < 4095)
                buf[i++] = (char)ch;
        } else buf[i++] = (char)ch;
    }
    buf[i] = '\0';
    *s = qb_string_new(buf);
}

void qb_file_input_int(int32_t fnum, int32_t* val) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    fscanf(_qb_files[fnum], "%d", val);
    int ch; while ((ch = fgetc(_qb_files[fnum])) == ',' || ch == ' ');
    if (ch != EOF && ch != '\n') ungetc(ch, _qb_files[fnum]);
}

void qb_file_input_float(int32_t fnum, double* val) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    fscanf(_qb_files[fnum], "%lf", val);
    int ch; while ((ch = fgetc(_qb_files[fnum])) == ',' || ch == ' ');
    if (ch != EOF && ch != '\n') ungetc(ch, _qb_files[fnum]);
}

void qb_file_line_input(int32_t fnum, qb_string** s) {
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    char buf[4096];
    if (fgets(buf, sizeof(buf), _qb_files[fnum])) {
        size_t len = strlen(buf);
        if (len > 0 && buf[len-1] == '\n') buf[--len] = '\0';
        *s = qb_string_new(buf);
    } else *s = qb_string_new("");
}

void qb_file_seek(int32_t fnum, int64_t pos) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fseek(_qb_files[fnum], (long)(pos - 1), SEEK_SET);
}

void qb_file_seek_record(int32_t fnum, int64_t rec) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fseek(_qb_files[fnum], (long)((rec - 1) * _qb_file_reclen[fnum]), SEEK_SET);
}

void qb_file_get(int32_t fnum, void* data, size_t size) {
    if (fnum < 0) {
        qb_net_get((int64_t)fnum, (uint8_t*)data, size);
        return;
    }
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fread(data, 1, size, _qb_files[fnum]);
}

void qb_file_get_string(int32_t fnum, qb_string* s) {
    if (fnum < 0) {
        qb_net_get_string((int64_t)fnum, s);
        return;
    }
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    if (!s || !s->data || s->len == 0) return;
    fread(s->data, 1, s->len, _qb_files[fnum]);
}

void qb_file_put_string(int32_t fnum, qb_string* s) {
    if (fnum < 0) {
        qb_net_put_string((int64_t)fnum, s);
        return;
    }
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return;
    if (!s || !s->data || s->len == 0) return;
    fwrite(s->data, 1, s->len, _qb_files[fnum]);
}

void qb_file_put(int32_t fnum, const void* data, size_t size) {
    if (fnum < 0) {
        qb_net_put((int64_t)fnum, (const uint8_t*)data, size);
        return;
    }
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        fwrite(data, 1, size, _qb_files[fnum]);
}

int32_t qb_eof(int32_t fnum) {
    if (fnum < 0) {
        return qb_net_eof((int64_t)fnum);
    }
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        return feof(_qb_files[fnum]) ? -1 : 0;
    return -1;
}

int64_t qb_lof(int32_t fnum) {
    if (fnum < 0) {
        return qb_net_lof((int64_t)fnum);
    }
    if (fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum]) return 0;
    long pos = ftell(_qb_files[fnum]);
    fseek(_qb_files[fnum], 0, SEEK_END);
    long len = ftell(_qb_files[fnum]);
    fseek(_qb_files[fnum], pos, SEEK_SET);
    return (int64_t)len;
}

int64_t qb_loc(int32_t fnum) {
    if (fnum >= 1 && fnum < QB_MAX_FILES && _qb_files[fnum])
        return (int64_t)ftell(_qb_files[fnum]) + 1;
    return 0;
}

int32_t qb_freefile(void) {
    for (int i = 1; i < QB_MAX_FILES; i++)
        if (!_qb_files[i]) return i;
    return 0;
}

/* FIELD Statement Support */
static char* _qb_field_buffer[QB_MAX_FILES];
static int32_t _qb_field_offset[QB_MAX_FILES];

void qb_field_start(int32_t fnum) {
    if (fnum < 1 || fnum >= QB_MAX_FILES) return;
    if (!_qb_field_buffer[fnum]) {
        _qb_field_buffer[fnum] = (char*)calloc(_qb_file_reclen[fnum], 1);
    }
    _qb_field_offset[fnum] = 0;
}

void qb_field_add(int32_t width, qb_string** var) {
    /* Note: FIELD requires special handling
       In classic BASIC, FIELD maps string variables directly
       to the file buffer. This is complex with ref-counted strings.
       For now, we create a fixed-length string. */
    if (*var) qb_string_release(*var);
    *var = qb_string_new_len(width);
    memset((*var)->data, ' ', width);
}

void qb_lset(qb_string** var, qb_string* value) {
    if (!*var || !value) return;
    int32_t var_len = (*var)->len;
    int32_t val_len = value->len;
    /* Fill with spaces first */
    memset((*var)->data, ' ', var_len);
    /* Copy value left-justified */
    int32_t copy_len = val_len < var_len ? val_len : var_len;
    memcpy((*var)->data, value->data, copy_len);
}

void qb_rset(qb_string** var, qb_string* value) {
    if (!*var || !value) return;
    int32_t var_len = (*var)->len;
    int32_t val_len = value->len;
    /* Fill with spaces first */
    memset((*var)->data, ' ', var_len);
    /* Copy value right-justified */
    int32_t copy_len = val_len < var_len ? val_len : var_len;
    int32_t offset = var_len - copy_len;
    memcpy((*var)->data + offset, value->data, copy_len);
}

/* Error Handling */

static int32_t _qb_err = 0;           /* Current error code */
static int32_t _qb_erl = 0;           /* Error line number */
static void* _qb_error_handler = NULL; /* Error handler label */
static int _qb_error_resume_next = 0;  /* ON ERROR RESUME NEXT flag */
static void* _qb_error_line = NULL;    /* Line that caused error */
static int32_t _INCLERRORLINE = 0;     /* Error line in include file */
static qb_string* _INCLERRORFILE_str = NULL; /* Include file with error */

void qb_error(int32_t code) {
    _qb_err = code;
    if (_qb_error_handler) {
        /* Jump to error handler - handled by generated code */
    }
}

int32_t qb_err_code(void) { return _qb_err; }

int32_t qb_err_line(void) { return _qb_erl; }

int64_t qb_errorline(void) { return _qb_erl; }

static const char* _qb_error_messages[] = {
    "No error",
    "NEXT without FOR",
    "Syntax error",
    "RETURN without GOSUB",
    "Out of DATA",
    "Illegal function call",
    "Overflow",
    "Out of memory",
    "Label not defined",
    "Subscript out of range",
    "Duplicate definition",
    "Division by zero",
    "Type mismatch",
    "Out of string space",
    "String too long",
    "String formula too complex",
};
#define QB_NUM_ERROR_MESSAGES (sizeof(_qb_error_messages)/sizeof(_qb_error_messages[0]))

qb_string* qb_errormessage(void) {
    if (_qb_err >= 0 && (size_t)_qb_err < QB_NUM_ERROR_MESSAGES)
        return qb_string_new(_qb_error_messages[_qb_err]);
    char buf[64];
    snprintf(buf, sizeof(buf), "Error %d", _qb_err);
    return qb_string_new(buf);
}

/* Keyboard Input Functions */

#ifdef _WIN32
#include <conio.h>
qb_string* qb_inkey(void) {
    if (_kbhit()) {
        int ch = _getch();
        if (ch == 0 || ch == 224) {
            char buf[3] = {0, (char)_getch(), 0};
            return qb_string_new(buf);
        }
        char buf[2] = {(char)ch, 0};
        return qb_string_new(buf);
    }
    return &_qbs_empty; /* No allocation for empty */
}
#else
#include <termios.h>
#include <unistd.h>
#include <sys/select.h>
qb_string* qb_inkey(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    fd_set fds; struct timeval tv = {0, 0};
    FD_ZERO(&fds); FD_SET(STDIN_FILENO, &fds);
    qb_string* result = &_qbs_empty; /* No allocation for empty */
    if (select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv) > 0) {
        char buf[4] = {0};
        int n = read(STDIN_FILENO, buf, sizeof(buf)-1);
        if (n > 0) result = qb_string_new(buf);
    }
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    return result;
}
#endif

qb_string* qb_input_chars(int32_t n) {
    if (n <= 0) return &_qbs_empty;
    char* buf = malloc((size_t)n + 1);
    for (int32_t i = 0; i < n; i++) buf[i] = (char)getchar();
    buf[n] = '\0';
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

qb_string* qb_input_chars_file(int32_t n, int32_t fnum) {
    if (n <= 0 || fnum < 1 || fnum >= QB_MAX_FILES || !_qb_files[fnum])
        return &_qbs_empty;
    char* buf = malloc((size_t)n + 1);
    size_t read = fread(buf, 1, (size_t)n, _qb_files[fnum]);
    buf[read] = '\0';
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

/* QB64 Keyboard Extensions */

static int64_t _qb_keybuf[256];
static int _qb_keybuf_head = 0;
static int _qb_keybuf_tail = 0;

#ifdef _WIN32
int64_t qb_keyhit(void) {
    if (!_kbhit()) return 0;
    int ch = _getch();
    if (ch == 0 || ch == 224) {
        int ext = _getch();
        return -(ext + 256); // Extended keys as negative
    }
    return ch;
}
#else
int64_t qb_keyhit(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    newt.c_cc[VMIN] = 0;
    newt.c_cc[VTIME] = 0;
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    int ch = getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    if (ch == EOF) return 0;
    if (ch == 27) { // Escape sequence
        tcsetattr(STDIN_FILENO, TCSANOW, &newt);
        int next = getchar();
        tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
        if (next != EOF) return -(next + 256);
    }
    return ch;
}
#endif

int64_t qb_keydown(int64_t code) {
    // Simplified implementation - always returns 0
    // Full implementation requires platform-specific key state checking
    (void)code;
    return 0;
}

#ifdef _WIN32
void qb_keyclear(void) {
    while (_kbhit()) _getch();
}
#else
void qb_keyclear(void) {
    tcflush(STDIN_FILENO, TCIFLUSH);
}
#endif

#ifdef _WIN32
int64_t qb_cinp(void) {
    return _getch();
}
#else
int64_t qb_cinp(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    int ch = getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    return (ch == EOF) ? 0 : ch;
}
#endif

#ifdef _WIN32
int64_t qb_capslock(void) {
    return (GetKeyState(VK_CAPITAL) & 1) ? -1 : 0;
}
int64_t qb_numlock(void) {
    return (GetKeyState(VK_NUMLOCK) & 1) ? -1 : 0;
}
int64_t qb_scrolllock(void) {
    return (GetKeyState(VK_SCROLL) & 1) ? -1 : 0;
}
#else
// On Linux/macOS, lock key states require X11 or reading /sys files
// Simplified stub implementation
int64_t qb_capslock(void) { return 0; }
int64_t qb_numlock(void) { return 0; }
int64_t qb_scrolllock(void) { return 0; }
#endif

/* Environment Functions */

qb_string* qb_environ(qb_string* var) {
    if (!var || !var->data) return &_qbs_empty;
    const char* val = getenv(var->data);
    return val ? qb_string_new(val) : &_qbs_empty;
}

static int _qb_argc = 0;
static char** _qb_argv = NULL;
void qb_init_args(int argc, char** argv) { _qb_argc = argc; _qb_argv = argv; }

qb_string* qb_command(void) {
    if (_qb_argc <= 1 || !_qb_argv) return &_qbs_empty;
    size_t len = 0;
    for (int i = 1; i < _qb_argc; i++) len += strlen(_qb_argv[i]) + 1;
    char* buf = malloc(len + 1);
    buf[0] = '\0';
    for (int i = 1; i < _qb_argc; i++) {
        if (i > 1) strcat(buf, " ");
        strcat(buf, _qb_argv[i]);
    }
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

qb_string* qb_command_n(int64_t n) {
    if (n < 0 || n >= _qb_argc || !_qb_argv) return &_qbs_empty;
    if (n == 0) return qb_command(); // Return all args
    return qb_string_new(_qb_argv[n]);
}

#ifdef _WIN32
#include <direct.h>
#define getcwd _getcwd
#endif
qb_string* qb_cwd(void) {
    char buf[4096];
    if (getcwd(buf, sizeof(buf))) return qb_string_new(buf);
    return &_qbs_empty;
}

qb_string* qb_os(void) {
#ifdef _WIN32
  #if defined(_WIN64) || defined(__x86_64__)
    return qb_string_new("[WINDOWS][64BIT]");
  #else
    return qb_string_new("[WINDOWS][32BIT]");
  #endif
#elif defined(__APPLE__)
  #if defined(__x86_64__) || defined(__aarch64__)
    return qb_string_new("[MACOSX][64BIT]");
  #else
    return qb_string_new("[MACOSX][32BIT]");
  #endif
#else
  #if defined(__x86_64__) || defined(__aarch64__)
    return qb_string_new("[LINUX][64BIT]");
  #else
    return qb_string_new("[LINUX][32BIT]");
  #endif
#endif
}

static char _qb_startdir[4096] = {};
void qb_init_startdir(void) { getcwd(_qb_startdir, sizeof(_qb_startdir)); }
qb_string* qb_startdir(void) { return qb_string_new(_qb_startdir); }

int32_t qb_instrrev(qb_string* source, qb_string* search) {
    if (!source || !search || search->len == 0) return 0;
    if (search->len > source->len) return 0;
    for (int32_t i = source->len - search->len; i >= 0; i--) {
        if (memcmp(source->data + i, search->data, search->len) == 0) {
            return i + 1; // 1-based
        }
    }
    return 0;
}

qb_string* qb_trim(qb_string* s) {
    if (!s || s->len == 0) return &_qbs_empty;
    int32_t start = 0, end = s->len - 1;
    while (start <= end && (s->data[start] == ' ' || s->data[start] == '\t')) start++;
    while (end >= start && (s->data[end] == ' ' || s->data[end] == '\t')) end--;
    if (start > end) return &_qbs_empty;
    int32_t newlen = end - start + 1;
    qb_string* result = (qb_string*)malloc(sizeof(qb_string));
    result->data = (char*)malloc(newlen + 1);
    result->len = newlen;
    result->capacity = newlen + 1;
    result->refcount = 1;
    memcpy(result->data, s->data + start, newlen);
    result->data[newlen] = '\0';
    return result;
}

qb_string* qb_mki(int16_t n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string));
    result->data = (char*)malloc(3);
    result->len = 2;
    result->capacity = 3;
    result->refcount = 1;
    memcpy(result->data, &n, 2);
    result->data[2] = '\0';
    return result;
}

qb_string* qb_mkl(int32_t n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string));
    result->data = (char*)malloc(5);
    result->len = 4;
    result->capacity = 5;
    result->refcount = 1;
    memcpy(result->data, &n, 4);
    result->data[4] = '\0';
    return result;
}

qb_string* qb_mks(float n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string));
    result->data = (char*)malloc(5);
    result->len = 4;
    result->capacity = 5;
    result->refcount = 1;
    memcpy(result->data, &n, 4);
    result->data[4] = '\0';
    return result;
}

qb_string* qb_mkd(double n) {
    qb_string* result = (qb_string*)malloc(sizeof(qb_string));
    result->data = (char*)malloc(9);
    result->len = 8;
    result->capacity = 9;
    result->refcount = 1;
    memcpy(result->data, &n, 8);
    result->data[8] = '\0';
    return result;
}

int16_t qb_cvi(qb_string* s) {
    if (!s || s->len < 2) return 0;
    int16_t result;
    memcpy(&result, s->data, 2);
    return result;
}

int32_t qb_cvl(qb_string* s) {
    if (!s || s->len < 4) return 0;
    int32_t result;
    memcpy(&result, s->data, 4);
    return result;
}

float qb_cvs(qb_string* s) {
    if (!s || s->len < 4) return 0.0f;
    float result;
    memcpy(&result, s->data, 4);
    return result;
}

double qb_cvd(qb_string* s) {
    if (!s || s->len < 8) return 0.0;
    double result;
    memcpy(&result, s->data, 8);
    return result;
}

#ifdef _WIN32
float qb_timer(void) {
    SYSTEMTIME st;
    GetLocalTime(&st);
    return st.wHour * 3600.0f + st.wMinute * 60.0f + st.wSecond + st.wMilliseconds / 1000.0f;
}
#else
float qb_timer(void) {
    struct timeval tv;
    gettimeofday(&tv, NULL);
    struct tm* tm = localtime(&tv.tv_sec);
    return tm->tm_hour * 3600.0f + tm->tm_min * 60.0f + tm->tm_sec + tv.tv_usec / 1000000.0f;
}
#endif

float qb_timer_n(double accuracy) {
    (void)accuracy; /* Ignored - max precision always used */
    return qb_timer();
}

qb_string* qb_date(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%m-%d-%Y", tm);
    return qb_string_new(buf);
}

qb_string* qb_time(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%H:%M:%S", tm);
    return qb_string_new(buf);
}

qb_string* qb_date64(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%Y-%m-%d", tm);
    return qb_string_new(buf);
}

qb_string* qb_time64(void) {
    time_t t = time(NULL);
    struct tm* tm = localtime(&t);
    char buf[16];
    strftime(buf, sizeof(buf), "%H:%M:%S", tm);
    return qb_string_new(buf);
}

/* QB64 Memory Operations */

#define QB_CMEM_SIZE 1114099
#define QB_DBLOCK_OFFSET 1280
static uint8_t qb_cmem[QB_CMEM_SIZE];
static uint8_t *qb_defseg = &qb_cmem[QB_DBLOCK_OFFSET];
static int32_t qb_current_segment = -1;

void qb_def_seg(int32_t segment) {
    qb_current_segment = segment;
    if (segment == -1) {
        qb_defseg = &qb_cmem[QB_DBLOCK_OFFSET];
    } else if (segment >= -65536 && segment <= 65535) {
        qb_defseg = &qb_cmem[0] + ((uint16_t)segment) * 16;
    }
}

int32_t qb_get_segment(void) {
    return qb_current_segment;
}

int qb_peek(int32_t offset) {
    if (offset < -65536 || offset > 65535) {
        return 0;
    }
    return qb_defseg[(uint16_t)offset];
}

void qb_poke(int32_t offset, uint8_t value) {
    if (offset < -65536 || offset > 65535) {
        return;
    }
    qb_defseg[(uint16_t)offset] = value;
}

typedef struct qb_mem {
    void* offset;      /* Pointer to data */
    intptr_t size;     /* Size in bytes */
    intptr_t type;     /* Type info (0=generic) */
    intptr_t elementsize; /* Element size for arrays */
    int32_t image;     /* Image handle if applicable */
    int32_t sound;     /* Sound handle if applicable */
} qb_mem;

qb_mem qb_memnew(intptr_t size) {
    qb_mem m;
    m.offset = (size > 0) ? calloc(1, (size_t)size) : NULL;
    m.size = (m.offset) ? size : 0;
    m.type = 0;
    m.elementsize = 1;
    m.image = 0;
    m.sound = 0;
    return m;
}

void qb_memfree(qb_mem* m) {
    if (m && m->offset) {
        free(m->offset);
        m->offset = NULL;
        m->size = 0;
    }
}

int64_t qb_memget(qb_mem m, intptr_t byteoffset) {
    if (!m.offset || byteoffset < 0 || byteoffset >= m.size) return 0;
    int64_t result = 0;
    size_t copysize = (size_t)(m.size - byteoffset);
    if (copysize > sizeof(int64_t)) copysize = sizeof(int64_t);
    memcpy(&result, (char*)m.offset + byteoffset, copysize);
    return result;
}

void qb_memput(qb_mem m, intptr_t byteoffset, int64_t value) {
    if (!m.offset || byteoffset < 0) return;
    size_t copysize = sizeof(int64_t);
    if (byteoffset + (intptr_t)copysize > m.size) {
        copysize = (size_t)(m.size - byteoffset);
    }
    if (copysize > 0) {
        memcpy((char*)m.offset + byteoffset, &value, copysize);
    }
}

void qb_memcopy(qb_mem src, intptr_t src_offset, intptr_t bytes, qb_mem dest, intptr_t dest_offset) {
    if (!src.offset || !dest.offset) return;
    if (src_offset < 0 || dest_offset < 0 || bytes <= 0) return;
    if (src_offset + bytes > src.size) bytes = src.size - src_offset;
    if (dest_offset + bytes > dest.size) bytes = dest.size - dest_offset;
    if (bytes > 0) {
        memmove((char*)dest.offset + dest_offset, (char*)src.offset + src_offset, (size_t)bytes);
    }
}

void qb_memfill(qb_mem m, intptr_t byteoffset, intptr_t bytes, int32_t value) {
    if (!m.offset || byteoffset < 0 || bytes <= 0) return;
    if (byteoffset + bytes > m.size) bytes = m.size - byteoffset;
    if (bytes > 0) {
        memset((char*)m.offset + byteoffset, (int)(value & 0xFF), (size_t)bytes);
    }
}

intptr_t qb_offset(void* ptr) {
    return (intptr_t)ptr;
}

qb_mem qb_mem_of(void* ptr, intptr_t size) {
    qb_mem m;
    m.offset = ptr;
    m.size = size;
    m.type = 0;
    m.elementsize = 1;
    m.image = 0;
    m.sound = 0;
    return m;
}

int32_t qb_memexists(qb_mem m) {
    return (m.offset != NULL && m.size > 0) ? -1 : 0;
}

qb_mem qb_memelement(qb_mem m, intptr_t index) {
    qb_mem result;
    if (!m.offset || m.elementsize <= 0 || index < 0) {
        result.offset = NULL;
        result.size = 0;
        result.type = 0;
        result.elementsize = 0;
        result.image = 0;
        result.sound = 0;
        return result;
    }
    intptr_t byte_offset = index * m.elementsize;
    if (byte_offset >= m.size) {
        result.offset = NULL;
        result.size = 0;
    } else {
        result.offset = (char*)m.offset + byte_offset;
        result.size = m.elementsize;
    }
    result.type = m.type;
    result.elementsize = m.elementsize;
    result.image = m.image;
    result.sound = m.sound;
    return result;
}

qb_mem qb_memimage(int32_t handle) {
    (void)handle;
    _qb_gfx_warn();
    qb_mem m = {NULL, 0, 0, 0, 0, 0};
    return m;
}

qb_mem qb_memsound(int32_t handle) {
    (void)handle;
    qb_mem m = {NULL, 0, 0, 0, 0, 0};
    return m;
}

int8_t qb_memget_byte(qb_mem m, intptr_t offset) {
    if (!m.offset || offset < 0 || offset >= m.size) return 0;
    return *((int8_t*)((char*)m.offset + offset));
}

int16_t qb_memget_integer(qb_mem m, intptr_t offset) {
    if (!m.offset || offset < 0 || offset + 2 > m.size) return 0;
    int16_t result;
    memcpy(&result, (char*)m.offset + offset, sizeof(int16_t));
    return result;
}

int32_t qb_memget_long(qb_mem m, intptr_t offset) {
    if (!m.offset || offset < 0 || offset + 4 > m.size) return 0;
    int32_t result;
    memcpy(&result, (char*)m.offset + offset, sizeof(int32_t));
    return result;
}

float qb_memget_single(qb_mem m, intptr_t offset) {
    if (!m.offset || offset < 0 || offset + 4 > m.size) return 0.0f;
    float result;
    memcpy(&result, (char*)m.offset + offset, sizeof(float));
    return result;
}

double qb_memget_double(qb_mem m, intptr_t offset) {
    if (!m.offset || offset < 0 || offset + 8 > m.size) return 0.0;
    double result;
    memcpy(&result, (char*)m.offset + offset, sizeof(double));
    return result;
}

void qb_memput_byte(qb_mem m, intptr_t offset, int8_t value) {
    if (!m.offset || offset < 0 || offset >= m.size) return;
    *((int8_t*)((char*)m.offset + offset)) = value;
}

void qb_memput_integer(qb_mem m, intptr_t offset, int16_t value) {
    if (!m.offset || offset < 0 || offset + 2 > m.size) return;
    memcpy((char*)m.offset + offset, &value, sizeof(int16_t));
}

void qb_memput_long(qb_mem m, intptr_t offset, int32_t value) {
    if (!m.offset || offset < 0 || offset + 4 > m.size) return;
    memcpy((char*)m.offset + offset, &value, sizeof(int32_t));
}

void qb_memput_single(qb_mem m, intptr_t offset, float value) {
    if (!m.offset || offset < 0 || offset + 4 > m.size) return;
    memcpy((char*)m.offset + offset, &value, sizeof(float));
}

void qb_memput_double(qb_mem m, intptr_t offset, double value) {
    if (!m.offset || offset < 0 || offset + 8 > m.size) return;
    memcpy((char*)m.offset + offset, &value, sizeof(double));
}

void qb_memfill_integer(qb_mem m, intptr_t offset, intptr_t count, int16_t value) {
    if (!m.offset || offset < 0 || count <= 0) return;
    intptr_t bytes = count * sizeof(int16_t);
    if (offset + bytes > m.size) bytes = m.size - offset;
    int16_t* ptr = (int16_t*)((char*)m.offset + offset);
    intptr_t n = bytes / sizeof(int16_t);
    for (intptr_t i = 0; i < n; i++) ptr[i] = value;
}

void qb_memfill_long(qb_mem m, intptr_t offset, intptr_t count, int32_t value) {
    if (!m.offset || offset < 0 || count <= 0) return;
    intptr_t bytes = count * sizeof(int32_t);
    if (offset + bytes > m.size) bytes = m.size - offset;
    int32_t* ptr = (int32_t*)((char*)m.offset + offset);
    intptr_t n = bytes / sizeof(int32_t);
    for (intptr_t i = 0; i < n; i++) ptr[i] = value;
}

void qb_memfill_single(qb_mem m, intptr_t offset, intptr_t count, float value) {
    if (!m.offset || offset < 0 || count <= 0) return;
    intptr_t bytes = count * sizeof(float);
    if (offset + bytes > m.size) bytes = m.size - offset;
    float* ptr = (float*)((char*)m.offset + offset);
    intptr_t n = bytes / sizeof(float);
    for (intptr_t i = 0; i < n; i++) ptr[i] = value;
}

void qb_memfill_double(qb_mem m, intptr_t offset, intptr_t count, double value) {
    if (!m.offset || offset < 0 || count <= 0) return;
    intptr_t bytes = count * sizeof(double);
    if (offset + bytes > m.size) bytes = m.size - offset;
    double* ptr = (double*)((char*)m.offset + offset);
    intptr_t n = bytes / sizeof(double);
    for (intptr_t i = 0; i < n; i++) ptr[i] = value;
}

/* Timing Functions */

static double qb_last_frame_time = 0.0;

#ifdef _WIN32
static double qb_get_time_seconds(void) {
    LARGE_INTEGER freq, count;
    QueryPerformanceFrequency(&freq);
    QueryPerformanceCounter(&count);
    return (double)count.QuadPart / (double)freq.QuadPart;
}
#else
static double qb_get_time_seconds(void) {
    struct timeval tv;
    gettimeofday(&tv, NULL);
    return (double)tv.tv_sec + (double)tv.tv_usec / 1000000.0;
}
#endif

#ifdef _WIN32
void qb_sleep(int seconds) {
    Sleep(seconds * 1000);
}
#else
void qb_sleep(int seconds) {
    sleep(seconds);
}
#endif

#ifdef _WIN32
void qb_sleep_keypress(void) {
    _getch();
}
#else
void qb_sleep_keypress(void) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    getchar();
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
}
#endif

#ifdef _WIN32
void qb_delay(double seconds) {
    Sleep((DWORD)(seconds * 1000.0));
}
#else
void qb_delay(double seconds) {
    usleep((useconds_t)(seconds * 1000000.0));
}
#endif

void qb_limit(int fps) {
    if (fps <= 0) return;
    double target_frame_time = 1.0 / (double)fps;
    double current_time = qb_get_time_seconds();
    if (qb_last_frame_time > 0.0) {
        double elapsed = current_time - qb_last_frame_time;
        double wait_time = target_frame_time - elapsed;
        if (wait_time > 0.0) {
#ifdef _WIN32
            Sleep((DWORD)(wait_time * 1000.0));
#else
            usleep((useconds_t)(wait_time * 1000000.0));
#endif
        }
    }
    qb_last_frame_time = qb_get_time_seconds();
}

/* Array Bounds Registry */
/* Tracks lower/upper bounds for each array dimension */

#define QBA_MAX_DIMS 8
#define QBA_REGISTRY_SIZE 1024

typedef struct {
    void* ptr;                           /* Array pointer (key) */
    int32_t num_dims;                    /* Number of dimensions */
    int32_t lower[QBA_MAX_DIMS];         /* Lower bounds per dimension */
    int32_t upper[QBA_MAX_DIMS];         /* Upper bounds per dimension */
} _qba_meta;

static _qba_meta _qba_registry[QBA_REGISTRY_SIZE];
static int _qba_count = 0;

static int _qba_hash(void* ptr) {
    return (int)(((uintptr_t)ptr >> 3) % QBA_REGISTRY_SIZE);
}

static _qba_meta* _qba_find(void* ptr) {
    if (!ptr) return NULL;
    int start = _qba_hash(ptr);
    for (int i = 0; i < QBA_REGISTRY_SIZE; i++) {
        int idx = (start + i) % QBA_REGISTRY_SIZE;
        if (_qba_registry[idx].ptr == ptr) return &_qba_registry[idx];
        if (_qba_registry[idx].ptr == NULL) return NULL;
    }
    return NULL;
}

void qb_array_register(void* ptr, int32_t lower, int32_t upper) {
    if (!ptr) return;
    _qba_meta* existing = _qba_find(ptr);
    if (existing) {
        existing->num_dims = 1;
        existing->lower[0] = lower;
        existing->upper[0] = upper;
        return;
    }
    int start = _qba_hash(ptr);
    for (int i = 0; i < QBA_REGISTRY_SIZE; i++) {
        int idx = (start + i) % QBA_REGISTRY_SIZE;
        if (_qba_registry[idx].ptr == NULL) {
            _qba_registry[idx].ptr = ptr;
            _qba_registry[idx].num_dims = 1;
            _qba_registry[idx].lower[0] = lower;
            _qba_registry[idx].upper[0] = upper;
            _qba_count++;
            return;
        }
    }
}

void qb_array_register_md(void* ptr, int32_t num_dims, int32_t* lowers, int32_t* uppers) {
    if (!ptr || num_dims <= 0 || num_dims > QBA_MAX_DIMS) return;
    _qba_meta* existing = _qba_find(ptr);
    _qba_meta* meta = existing;
    if (!meta) {
        int start = _qba_hash(ptr);
        for (int i = 0; i < QBA_REGISTRY_SIZE; i++) {
            int idx = (start + i) % QBA_REGISTRY_SIZE;
            if (_qba_registry[idx].ptr == NULL) {
                meta = &_qba_registry[idx];
                meta->ptr = ptr;
                _qba_count++;
                break;
            }
        }
    }
    if (meta) {
        meta->num_dims = num_dims;
        for (int d = 0; d < num_dims; d++) {
            meta->lower[d] = lowers[d];
            meta->upper[d] = uppers[d];
        }
    }
}

void qb_array_update(void* old_ptr, void* new_ptr, int32_t lower, int32_t upper) {
    if (old_ptr == new_ptr) {
        _qba_meta* meta = _qba_find(old_ptr);
        if (meta) { meta->lower[0] = lower; meta->upper[0] = upper; }
        else qb_array_register(new_ptr, lower, upper);
    } else {
        _qba_meta* meta = _qba_find(old_ptr);
        if (meta) meta->ptr = NULL;
        qb_array_register(new_ptr, lower, upper);
    }
}

/* Array Functions */

int32_t qb_lbound(void* arr) {
    _qba_meta* meta = _qba_find(arr);
    return meta ? meta->lower[0] : 0;
}

int32_t qb_lbound2(void* arr, int32_t dim) {
    _qba_meta* meta = _qba_find(arr);
    if (!meta || dim < 1 || dim > meta->num_dims) return 0;
    return meta->lower[dim - 1];
}

int32_t qb_ubound(void* arr) {
    _qba_meta* meta = _qba_find(arr);
    return meta ? meta->upper[0] : 0;
}

int32_t qb_ubound2(void* arr, int32_t dim) {
    _qba_meta* meta = _qba_find(arr);
    if (!meta || dim < 1 || dim > meta->num_dims) return 0;
    return meta->upper[dim - 1];
}

void qb_array_erase(void* arr) {
    _qba_meta* meta = _qba_find(arr);
    if (meta) meta->ptr = NULL;  /* Clear entry */
}

