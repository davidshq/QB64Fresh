#ifndef _WIN32
static void _qb_normalize_path_inplace(char* path) {
    if (!path) return;
    for (char* p = path; *p; p++) {
        if (*p == '\\') *p = '/';
    }
}
#else
#define _qb_normalize_path_inplace(p) ((void)0)
#endif

int32_t qb_file_exists(qb_string* path) {
    if (!path || !path->data) return 0;
    struct stat st;
    if (stat(path->data, &st) == 0 && S_ISREG(st.st_mode)) return -1;
#ifndef _WIN32
    /* Try with normalized path */
    char* norm = strdup(path->data);
    _qb_normalize_path_inplace(norm);
    int result = stat(norm, &st) == 0 && S_ISREG(st.st_mode) ? -1 : 0;
    free(norm);
    return result;
#else
    return 0;
#endif
}
int32_t qb_dir_exists(qb_string* path) {
    if (!path || !path->data) return 0;
    struct stat st;
    if (stat(path->data, &st) == 0 && S_ISDIR(st.st_mode)) return -1;
#ifndef _WIN32
    /* Try with normalized path */
    char* norm = strdup(path->data);
    _qb_normalize_path_inplace(norm);
    int result = stat(norm, &st) == 0 && S_ISDIR(st.st_mode) ? -1 : 0;
    free(norm);
    return result;
#else
    return 0;
#endif
}
qb_string* qb_fullpath(qb_string* path) {
    if (!path || !path->data) return qb_string_new("");
    char resolved[4096];
#ifdef _WIN32
    if (_fullpath(resolved, path->data, sizeof(resolved)))
        return qb_string_new(resolved);
#else
    char* normalized = strdup(path->data);
    if (normalized) {
        _qb_normalize_path_inplace(normalized);
        if (realpath(normalized, resolved)) {
            free(normalized);
            return qb_string_new(resolved);
        }
        free(normalized);
    }
#endif
    return qb_string_new(path->data ? path->data : "");
}
qb_string* qb_dir(qb_string* spec) { (void)spec; return qb_string_new(""); }
int32_t qb_chdir(const char* path) {
    if (!path) return -1;
#ifdef _WIN32
    return _chdir(path) == 0 ? 0 : -1;
#else
    char* n = strdup(path);
    if (!n) return -1;
    _qb_normalize_path_inplace(n);
    int r = chdir(n) == 0 ? 0 : -1;
    free(n);
    return r;
#endif
}
int32_t qb_mkdir(const char* path) {
    if (!path) return -1;
#ifdef _WIN32
    return mkdir(path, 0755) == 0 ? 0 : -1;
#else
    char* n = strdup(path);
    if (!n) return -1;
    _qb_normalize_path_inplace(n);
    int r = mkdir(n, 0755) == 0 ? 0 : -1;
    free(n);
    return r;
#endif
}
int32_t qb_rmdir(const char* path) {
    if (!path) return -1;
#ifdef _WIN32
    return _rmdir(path) == 0 ? 0 : -1;
#else
    char* n = strdup(path);
    if (!n) return -1;
    _qb_normalize_path_inplace(n);
    int r = rmdir(n) == 0 ? 0 : -1;
    free(n);
    return r;
#endif
}
int32_t qb_file_kill(const char* filename) {
    if (!filename) return -1;
#ifdef _WIN32
    return remove(filename) == 0 ? 0 : -1;
#else
    char* n = strdup(filename);
    if (!n) return -1;
    _qb_normalize_path_inplace(n);
    int r = remove(n) == 0 ? 0 : -1;
    free(n);
    return r;
#endif
}
int32_t qb_file_rename(const char* old_name, const char* new_name) {
    if (!old_name || !new_name) return -1;
#ifdef _WIN32
    return rename(old_name, new_name) == 0 ? 0 : -1;
#else
    char* o = strdup(old_name);
    char* n = strdup(new_name);
    if (!o || !n) { free(o); free(n); return -1; }
    _qb_normalize_path_inplace(o);
    _qb_normalize_path_inplace(n);
    int r = rename(o, n) == 0 ? 0 : -1;
    free(o);
    free(n);
    return r;
#endif
}

