/* Temporary String Pool */
#define QBS_TMP_MAX 16384
static qb_string* _qbs_tmp_pool[QBS_TMP_MAX];
static uint32_t _qbs_tmp_next = 0;

/* Overflow tracking for when pool is full */
#define QBS_TMP_OVERFLOW_MAX 16384
static qb_string* _qbs_tmp_overflow[QBS_TMP_OVERFLOW_MAX];
static uint32_t _qbs_tmp_overflow_count = 0;

uint64_t qbs_tmp_base_get(void) {
    uint64_t main_base = (uint64_t)_qbs_tmp_next;
    uint64_t overflow_base = (uint64_t)_qbs_tmp_overflow_count;
    return main_base | (overflow_base << 32);
}

qb_string* qbs_tmp_register(qb_string* s) {
    if (!s || s == &_qbs_empty) return s;
    if (_qbs_tmp_next < QBS_TMP_MAX) {
        _qbs_tmp_pool[_qbs_tmp_next++] = s;
    } else {
        /* Pool full - track in overflow to prevent leak */
        if (_qbs_tmp_overflow_count < QBS_TMP_OVERFLOW_MAX) {
            _qbs_tmp_overflow[_qbs_tmp_overflow_count++] = s;
        } else {
            /* Overflow list also full - extremely rare edge case */
            /* Don't track this string to preserve scoping correctness */
            /* Overwriting any index would break nested scope cleanup */
            /* The string will leak, but this is safer than undefined behavior */
            /* TODO: Consider adding debug logging/warning when this occurs */
        }
    }
    return s;
}

void qbs_cleanup(uint64_t base, int dummy) {
    (void)dummy;
    uint32_t main_base = (uint32_t)(base & 0xFFFFFFFF);
    uint32_t overflow_base = (uint32_t)(base >> 32);
    while (_qbs_tmp_next > main_base) {
        _qbs_tmp_next--;
        qb_string* s = _qbs_tmp_pool[_qbs_tmp_next];
        _qbs_tmp_pool[_qbs_tmp_next] = NULL;
        if (s && s != &_qbs_empty && s->refcount > 0) {
            s->refcount--;
            if (s->refcount == 0) {
                free(s->data);
                free(s);
            }
        }
    }
    /* Clean up overflow strings registered since mark */
    while (_qbs_tmp_overflow_count > overflow_base) {
        _qbs_tmp_overflow_count--;
        qb_string* s = _qbs_tmp_overflow[_qbs_tmp_overflow_count];
        _qbs_tmp_overflow[_qbs_tmp_overflow_count] = NULL;
        if (s && s != &_qbs_empty && s->refcount > 0) {
            s->refcount--;
            if (s->refcount == 0) {
                free(s->data);
                free(s);
            }
        }
    }
}

qb_string* qb_string_new(const char* s) {
    if (!s || s[0] == '\0') return &_qbs_empty;
    qb_string* str = malloc(sizeof(qb_string));
    str->len = strlen(s);
    str->capacity = str->len + 1;
    str->data = malloc(str->capacity);
    memcpy(str->data, s, str->len + 1);
    str->refcount = 1;
    return qbs_tmp_register(str);
}

qb_string* qb_string_new_len(size_t len) {
    qb_string* str = malloc(sizeof(qb_string));
    str->len = len;
    str->capacity = len + 1;
    str->data = malloc(str->capacity);
    memset(str->data, ' ', len);
    str->data[len] = '\0';
    str->refcount = 1;
    return qbs_tmp_register(str);
}

void qb_string_free(qb_string* s) {
    if (s && s != &_qbs_empty) { free(s->data); free(s); }
}

qb_string* qb_string_retain(qb_string* s) {
    if (s && s != &_qbs_empty) s->refcount++;
    return s;
}

void qb_string_release(qb_string* s) {
    if (s && s != &_qbs_empty) {
        s->refcount--;
        if (s->refcount <= 0) {
            free(s->data);
            free(s);
        }
    }
}

qb_string* qb_string_concat(qb_string* a, qb_string* b) {
    int a_valid = a && a->data && a->len < 0x10000000;
    int b_valid = b && b->data && b->len < 0x10000000;
    if (!a_valid && !b_valid) return &_qbs_empty;
    if (!a_valid) return qb_string_new(b->data);
    if (!b_valid) return qb_string_new(a->data);
    qb_string* result = malloc(sizeof(qb_string));
    result->len = a->len + b->len;
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    result->refcount = 1;
    memcpy(result->data, a->data, a->len);
    memcpy(result->data + a->len, b->data, b->len + 1);
    return qbs_tmp_register(result);
}

