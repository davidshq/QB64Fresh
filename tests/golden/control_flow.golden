}

qb_string* qb_varptr_str(void* ptr) {
    qb_string* result = malloc(sizeof(qb_string));
    result->len = sizeof(void*);
    result->capacity = result->len + 1;
    result->data = malloc(result->capacity);
    memcpy(result->data, &ptr, sizeof(void*));
    result->data[result->len] = '\0';
    return result;
}

