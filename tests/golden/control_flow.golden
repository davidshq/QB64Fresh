/* File Content Helpers */

qb_string* qb_readfile(qb_string* path) {
    if (!path || !path->data) return qb_string_new("");
    FILE* f = fopen(path->data, "rb");
#ifndef _WIN32
    if (!f) {
        char* n = _qb_normalize_path(path->data);
        if (n) { f = fopen(n, "rb"); free(n); }
    }
#endif
    if (!f) return qb_string_new("");
    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);
    char* buf = (char*)malloc(size + 1);
    if (!buf) { fclose(f); return qb_string_new(""); }
    fread(buf, 1, size, f);
    buf[size] = '\0';
    fclose(f);
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

void qb_writefile(qb_string* path, qb_string* content) {
    if (!path || !path->data || !content || !content->data) return;
    FILE* f = fopen(path->data, "wb");
#ifndef _WIN32
    if (!f) {
        char* n = _qb_normalize_path(path->data);
        if (n) { f = fopen(n, "wb"); free(n); }
    }
#endif
    if (!f) return;
    fwrite(content->data, 1, content->len, f);
    fclose(f);
}

/* Utility Functions */

int64_t qb_commandcount(void) { return _qb_argc - 1; }

#ifdef _WIN32
int64_t qb_environcount(void) {
    int count = 0;
    char* env = GetEnvironmentStringsA();
    if (env) {
        char* p = env;
        while (*p) { count++; p += strlen(p) + 1; }
        FreeEnvironmentStringsA(env);
    }
    return count;
}
#else
extern char** environ;
int64_t qb_environcount(void) {
    int count = 0;
    if (environ) {
        while (environ[count]) count++;
    }
    return count;
}
#endif

