static int qb_cursor_col = 1;
static int qb_cursor_row = 1;

qb_string* qb_tab(int64_t n) {
    if (n < 1) n = 1;
    int spaces_needed = (int)(n - qb_cursor_col);
    if (spaces_needed < 0) spaces_needed = 0;
    char* buf = (char*)malloc(spaces_needed + 1);
    memset(buf, ' ', spaces_needed);
    buf[spaces_needed] = '\0';
    qb_cursor_col = (int)n;
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

qb_string* qb_spc(int64_t n) {
    if (n < 0) n = 0;
    char* buf = (char*)malloc((size_t)n + 1);
    memset(buf, ' ', (size_t)n);
    buf[n] = '\0';
    qb_cursor_col += (int)n;
    qb_string* result = qb_string_new(buf);
    free(buf);
    return result;
}

int qb_pos(int64_t n) {
    (void)n; // unused, for compatibility
    return qb_cursor_col;
}

int qb_csrlin(void) {
    return qb_cursor_row;
}

#define QB_TYPE_STRING 0
#define QB_TYPE_INT 1
#define QB_TYPE_DOUBLE 2

typedef struct {
    int type;
    union {
        qb_string* str_val;
        int64_t int_val;
        double dbl_val;
    };
} QbPrintValue;

void qb_print_using(qb_string* fmt, QbPrintValue* values, int num_values) {
    if (!fmt || !fmt->data) return;
    const char* f = fmt->data;
    int val_idx = 0;
    while (*f) {
        // Check for format specifiers
        if (*f == '#' || *f == '+' || *f == '-' || *f == '$' || *f == '*' || *f == '^') {
            // Numeric format - count consecutive format chars
            int width = 0, decimals = 0, has_decimal = 0, has_sign = 0;
            int has_dollar = 0, has_asterisk = 0, has_exp = 0, exp_digits = 0;
            const char* start = f;
            if (*f == '+' || *f == '-') { has_sign = 1; f++; width++; }
            if (*f == '$' && *(f+1) == '$') { has_dollar = 1; f += 2; width += 2; }
            else if (*f == '*' && *(f+1) == '*') { has_asterisk = 1; f += 2; width += 2; }
            while (*f == '#') { width++; f++; }
            if (*f == '.') { has_decimal = 1; f++; width++; while (*f == '#') { decimals++; width++; f++; } }
            while (*f == '^') { has_exp = 1; exp_digits++; f++; width++; }
            // Now format the value
            if (val_idx < num_values && width > 0) {
                double val = 0;
                if (values[val_idx].type == QB_TYPE_INT) val = (double)values[val_idx].int_val;
                else if (values[val_idx].type == QB_TYPE_DOUBLE) val = values[val_idx].dbl_val;
                char buf[64];
                if (has_exp) {
                    snprintf(buf, sizeof(buf), "%*.*e", width, decimals, val);
                } else if (has_decimal) {
                    snprintf(buf, sizeof(buf), "%*.*f", width, decimals, val);
                } else {
                    snprintf(buf, sizeof(buf), "%*lld", width, (long long)val);
                }
                // Handle asterisk fill
                if (has_asterisk) {
                    for (int i = 0; buf[i] == ' '; i++) buf[i] = '*';
                }
                printf("%s", buf);
                val_idx++;
            }
        } else if (*f == '&') {
            // String - print full string
            f++;
            if (val_idx < num_values && values[val_idx].type == QB_TYPE_STRING) {
                if (values[val_idx].str_val && values[val_idx].str_val->data) {
                    printf("%s", values[val_idx].str_val->data);
                }
                val_idx++;
            }
        } else if (*f == '!') {
            // String - print first character only
            f++;
            if (val_idx < num_values && values[val_idx].type == QB_TYPE_STRING) {
                if (values[val_idx].str_val && values[val_idx].str_val->data && values[val_idx].str_val->data[0]) {
                    printf("%c", values[val_idx].str_val->data[0]);
                }
                val_idx++;
            }
        } else if (*f == '\\') {
            // Fixed-width string - count spaces between backslashes
            f++;
            int str_width = 2; // includes both backslashes
            while (*f && *f != '\\') { str_width++; f++; }
            if (*f == '\\') f++;
            if (val_idx < num_values && values[val_idx].type == QB_TYPE_STRING) {
                const char* s = values[val_idx].str_val ? values[val_idx].str_val->data : "";
                printf("%-*.*s", str_width, str_width, s ? s : "");
                val_idx++;
            }
        } else if (*f == '_') {
            // Literal next character
            f++;
            if (*f) { printf("%c", *f); f++; }
        } else {
            // Literal character
            printf("%c", *f);
            f++;
        }
    }
}

void qb_input_string(const char* prompt, qb_string** var) {
    char buffer[1024];
    if (prompt) printf("%s", prompt);
    if (fgets(buffer, sizeof(buffer), stdin)) {
        size_t len = strlen(buffer);
        if (len > 0 && buffer[len-1] == '\n') buffer[len-1] = '\0';
        if (*var) qb_string_free(*var);
        *var = qb_string_new(buffer);
    }
}

void qb_input_int(const char* prompt, int32_t* var) {
    if (prompt) printf("%s", prompt);
    scanf("%d", var);
}

void qb_input_float(const char* prompt, double* var) {
    if (prompt) printf("%s", prompt);
    scanf("%lf", var);
}

int qb_string_compare(qb_string* a, qb_string* b) {
    size_t a_len = (a && a->data) ? a->len : 0;
    size_t b_len = (b && b->data) ? b->len : 0;
    const char* a_data = (a && a->data) ? a->data : "";
    const char* b_data = (b && b->data) ? b->data : "";
    size_t min_len = (a_len < b_len) ? a_len : b_len;
    int cmp = memcmp(a_data, b_data, min_len);
    if (cmp == 0) {
        if (a_len < b_len) return -1;
        if (a_len > b_len) return 1;
        return 0;
    }
    return cmp;
}

int32_t qb_len_str(qb_string* s) {
    return s ? (int32_t)s->len : 0;
}

qb_string* qb_chr(int32_t code) {
    char buf[2] = { (char)code, '\0' };
    return qb_string_new(buf);
}

int32_t qb_asc(qb_string* s) {
