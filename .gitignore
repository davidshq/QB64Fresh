# Build artifacts
/target/
**/*.rs.bk
Cargo.lock

# IDE
.idea/
*.swp
*.swo
*~

# VS Code - ignore user-specific settings, keep shared configs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db

# Full interaction logs - too verbose for version control
# These are raw session logs used for reconstructing troubleshooting history
/FullLogs/

# Generated files
*.o
*.a
*.so
*.dylib

# Generated C files from compiler
examples/*.c
examples/**/*.c

# Generated C in tests (compiler output)
tests/golden/*.c
tests/qb64pe_incremental/*.c

# Generated by scripts/gl_parse_header.py
runtime/c_src/gl_wrappers_generated.inc

# Test artifacts
/tmp/

# Runtime comparison test output (run_comparison.sh writes results/fresh/, results/qb64pe/)
/tests/runtime_comparison/results/
# Files/dirs created by running comparison tests (e.g. 174_input_hash.bas, 213_chdir.bas)
/tests/runtime_comparison/rt_*

# QB64pe incremental test build artifacts (manifest referenced by icon.rc)
/tests/qb64pe_incremental/manifest.h
/tests/qb64pe_incremental/output.manifest

# Mutation testing output (cargo-mutants)
/mutants.out/
/mutants.out.old/


# Added by cargo

/target

# Temporary files
/temp
